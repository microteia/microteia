{
  "name": "microteia",
  "private": true,
  "version": "0.151.0",
  "type": "module",
  "scripts": {
    "predev": "npm run sync-schemas",
    "dev": "vite --mode dev",
    "prebuild": "npm run sync-schemas",
    "build": "tsc -b && vite build --mode ${TARGET:-dev}",
    "lint": "eslint .",
    "typecheck": "tsc -b --force",
    "sync-schemas": "node scripts/sync-schemas.cjs",
    "verify-schemas": "node scripts/sync-schemas.cjs --check",
    "verify": "npm run typecheck && npm run lint && npm run verify-schemas",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:functions": "npm run sync-schemas && tsc -b functions",
    "deploy:prod": "TARGET=prod npm run deploy",
    "deploy:hosting:prod": "TARGET=prod npm run deploy:hosting",
    "deploy": "npm run build:functions && firebase deploy --project ${TARGET:-dev}",
    "deploy:hosting": "npm run build && npm run build:functions && firebase deploy --only hosting --project ${TARGET:-dev}",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --project ${TARGET:-dev}",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project ${TARGET:-dev}",
    "deploy:workflow": "npm run build:functions && firebase deploy --only functions:onWorkflowEventCreated,functions:publishWorkflowEventOnEntityChange,functions:recomputeAggregatesOnEntityChange,functions:onNoteChange,functions:onDocumentChange,functions:getExpressionFunctions,functions:getWorkflowStepCatalog,functions:detectWorkflows,functions:runWorkflow,functions:syncPublicWorkflowOnWrite,functions:syncPublicWorkflowOnDelete,functions:copyPublicWorkflow,functions:updateFromSourceWorkflow,functions:runScript,functions:runAction --project ${TARGET:-dev}",
    "deploy:audit": "npm run build:functions && firebase deploy --only functions:auditFlatEntityChange,functions:auditNestedEntityChange,functions:auditTenantDeleted,functions:auditNewsChange,functions:auditNewsCommentChange,functions:auditNewsTagChange,functions:backupDeletedAuditLog --project ${TARGET:-dev}",
    "deploy:auth": "npm run build:functions && firebase deploy --only functions:getUserInfo,functions:checkNicknameAvailability,functions:claimNickname,functions:onUserCreated --project ${TARGET:-dev}",
    "deploy:tenant": "npm run build:functions && firebase deploy --only functions:addTenantMember,functions:removeTenantMember --project ${TARGET:-dev}",
    "deploy:gmail": "npm run build:functions && firebase deploy --only functions:gmailPush,functions:renewGmailWatches,functions:exchangeGmailCode --project ${TARGET:-dev}",
    "deploy:util": "npm run build:functions && firebase deploy --only functions:callAIProxy,functions:logClientError,functions:cascadeDeletePushInteractions --project ${TARGET:-dev}",
    "deploy:functions": "npm run build:functions && firebase deploy --only functions --project ${TARGET:-dev}",
    "deploy:functions:individual": "node scripts/deploy-functions-individually.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/styled-components": "^5.1.36",
    "date-fns": "^4.4.0",
    "expr-eval": "^2.0.2",
    "firebase": "^12.14.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^6.0.227",
    "quill": "^2.0.3",
    "react": "^19.2.6",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.4.2",
    "sucrase": "^3.35.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
