# ============================================
# AI PARSING CONFIGURATION
# ============================================
# Configurações de IA para fallback de parsing de emails
# Quando nenhum parser regex conseguir extrair dados do email,
# o sistema usa IA para tentar extrair as informações processuais.

# Provider de IA: openai | anthropic | google | mistral | cohere
AI_PROVIDER=openai

# Chave de API do provider escolhido
AI_API_KEY=sk-...

# Modelo a ser usado
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
# Google: gemini-pro
AI_MODEL=gpt-4

# Temperatura (0-1): quanto maior, mais criativo/variado
# Para parsing, recomendado: 0-0.3 (mais determinístico)
AI_TEMPERATURE=0.3

# Máximo de tokens na resposta
AI_MAX_TOKENS=2000

# ============================================
# GMAIL OAUTH CONFIGURATION
# ============================================
# Configurações para autenticação OAuth do Gmail
# Necessário para renovar tokens de acesso quando expirarem
# Obter em: https://console.cloud.google.com/apis/credentials

# Client ID do Google Cloud Console
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Client Secret do Google Cloud Console
GMAIL_CLIENT_SECRET=your-client-secret

# Redirect URI configurado no Google Cloud Console
# Produção: https://seu-dominio.com/auth/gmail/callback
# Desenvolvimento: http://localhost:3000/auth/gmail/callback
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
