{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.extsrc.tsbuildinfo",
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "noEmit": true,

    // `false`, e é o ponto do arquivo: a API curada É a biblioteca aqui, e com `skipLibCheck` um nome
    // que não resolve DENTRO dela não reprova nada — só faz o tipo virar `any`. Foi assim que o
    // `React.HTMLAttributes` de `styled-components` ficou sem namespace e o `theme` parou de completar
    // no editor do autor, sem uma única linha vermelha em lugar nenhum.
    "skipLibCheck": false,

    "strict": true,
    "noFallthroughCasesInSwitch": true,

    "noImplicitAny": false,
    "strictNullChecks": false,

    "paths": {
      "@microteia/*": ["./sdk/types/microteia-host.d.ts"],
      "react": ["./sdk/types/microteia-host.d.ts"],
      "react/jsx-runtime": ["./sdk/types/microteia-host.d.ts"],
      "styled-components": ["./sdk/types/microteia-host.d.ts"]
    }
  },
  "include": ["src/plugins/marketplace/views", "src/plugins/marketplace/examples/*/views"],
  // Só o teste da RAIZ de `views/` fica de fora: ele é nosso, usa `import.meta.glob` e não viaja. O
  // `.rules.test.ts` ao lado de uma view viaja no pacote como exemplo, e o `tsconfig.json` do
  // escritório o confere — excluí-lo aqui deixava passar o que reprova lá.
  "exclude": ["src/plugins/marketplace/views/*.test.ts"]
}
