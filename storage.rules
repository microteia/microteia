rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Fotos de perfil de usuário ───────────────────────────────────────────
    // Path: userPhotos/{userId}/{filename}
    match /userPhotos/{userId}/{allPaths=**} {
      // Qualquer usuário autenticado pode ler fotos de perfil
      allow read: if request.auth != null;
      // Somente o próprio usuário pode fazer upload/delete da sua foto
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024       // máximo 5 MB
        && request.resource.contentType.matches('image/.*');
    }

    // ─── O ORÇAMENTO: no máximo DOIS documentos do Firestore por avaliação ───
    //
    // O Storage recusa a avaliação que lê mais de dois documentos DISTINTOS do Firestore. Ler de novo
    // um documento que EXISTE sai do cache e não conta; perguntar de novo por um que NÃO existe conta
    // outra vez — medido no microteia-dev, e não documentado. Por isso todo documento que pode faltar
    // (o membro, para o SYSTEM; a tela; o registro) é perguntado UMA vez por caminho: a função que o
    // lê passa o `data` adiante em vez de chamar `firestore.exists` de novo.
    //
    // O emulador NÃO cobra esse limite: a regra passa em
    // `npm run test:rules` e é recusada em produção, sem erro que diga o porquê — o cliente recebe só
    // `storage/unauthorized`. Foi assim que, em 11/2026, só o SYSTEM conseguia anexar documento: a
    // pergunta do dono passou a ler `users` + `tenants/{id}` + `members/{uid}`.
    //
    // Por isso a ordem das perguntas aqui é decisão, não estilo:
    // 1. o documento de MEMBRO vem primeiro. Ele responde sozinho por permissão e segundo fator — o dono
    //    inclusive, porque o servidor carimba nele o curinga `*` (`materializeMemberPermissions`). Não
    //    há leitura de `tenants/{id}.ownerId`: ela era o terceiro documento.
    // 2. `users/{uid}` (SYSTEM/SUPPORT) só é lido quando o membro não respondeu — e quem chega até ele
    //    não lê mais nada, porque o SYSTEM vê todo registro.
    // 3. a tela (`screenDefinitions`) e o registro só entram depois do membro, e o registro só quando a
    //    tela declara `memberVisibility` ou `editWindow`.
    //
    // Passar do teto não libera nada: a consulta excedente vira ERRO, e erro só cede num `||` cujo outro
    // lado já é verdadeiro sozinho. É o que deixa o supervisor apagar sob `memberVisibility` mesmo com o
    // registro fora da conta. A resposta dele não depende do registro.
    //
    // A conta de cada caminho está ao lado de cada `match`. Ao mexer aqui, refaça-a.
    function memberDocPath(tenantId) {
      return /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    // SYSTEM ou SUPPORT — ambos agem como admin em qualquer tenant nas regras de Storage abaixo (mesmo
    // racional de isSystemOrSupport() nas regras do Firestore). Lido por ÚLTIMO em toda pergunta.
    function isSystemOrSupportUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['SYSTEM', 'SUPPORT'];
    }
    // O segundo fator que o escritório exige do membro — a MESMA conta de `sessionSatisfiesMfa` no
    // `firestore.rules`. O Storage não tem `request.method`, então quem chama diz se está agindo: ler
    // exige ter provado; agir exige ter provado há menos de `maxAgeSeconds`.
    function sessionSatisfiesMfa(member, acting) {
      let requirement = member.get('mfa', null);
      let verifiedAt = request.auth.token.get('mfaAt', 0);
      return requirement == null
        || (verifiedAt is number && verifiedAt > 0
            && (!acting || request.time.toMillis() < (verifiedAt + requirement.maxAgeSeconds) * 1000));
    }
    // A MESMA pergunta do `can()` do Firestore, respondida só pelo documento de membro: a lista EFETIVA
    // de permissões (`permissions`, materializada pelo servidor) tem a pedida ou o curinga `*` do dono, e
    // a sessão tem a prova que o escritório exige.
    //
    // Toda permissão que não termina em `.read` é tratada como AGIR, e pede a prova recente: errar para
    // esse lado só pede o código mais cedo; errar para o outro deixaria a sessão vencida gravar.
    function memberCan(tenantId, permission) {
      let memberPath = memberDocPath(tenantId);
      return firestore.exists(memberPath) && memberDataCan(firestore.get(memberPath).data, permission);
    }
    // As duas permissões numa pergunta só: chamar `memberCan` duas vezes perguntaria duas vezes pelo
    // membro que não existe — e o SYSTEM que não é membro estouraria o teto antes de chegar a `users`.
    function memberCanEither(tenantId, first, second) {
      let memberPath = memberDocPath(tenantId);
      return firestore.exists(memberPath)
        && (memberDataCan(firestore.get(memberPath).data, first) || memberDataCan(firestore.get(memberPath).data, second));
    }
    function memberDataCan(member, permission) {
      return member.get('permissions', []).hasAny([permission, '*'])
        && sessionSatisfiesMfa(member, !permission.matches('.*[.]read$'));
    }
    // O SYSTEM entra quando o membro não respondeu — e é o que o dispensa da política do escritório
    // mesmo sendo membro dele, como em `isTenantMember` no `firestore.rules` (EV-36).
    function canInTenant(tenantId, permission) {
      return memberCan(tenantId, permission) || isSystemOrSupportUser();
    }
    function isTenantMemberOrElevated(tenantId) {
      let memberPath = memberDocPath(tenantId);
      return (firestore.exists(memberPath) && sessionSatisfiesMfa(firestore.get(memberPath).data, false))
        || isSystemOrSupportUser();
    }

    // As coleções de entidade que saíram do kernel (`cases`, `persons`, `contracts`, `financials`) NÃO
    // têm bloco próprio: o modelo de acesso delas é idêntico ao do curinga abaixo, que já as cobre. Um
    // bloco por coleção obrigaria a editar este arquivo a cada extensão nova.
    //
    // SOBRESCREVER é `create`, não `update`, para o Storage: o `update` só cobre metadado. Por isso todo
    // `create` daqui exige `resource == null` — o objeto ainda não existe. Antes, o comentário supunha o
    // contrário, e qualquer um que pudesse enviar trocava o conteúdo de um arquivo já anexado sem que o
    // documento, o link ou a auditoria mudassem. Os caminhos de envio sempre carregam um nome novo
    // (`Date.now()`, um UUID), e nenhum deles precisa gravar por cima.

    // ─── Documentos de registros de qualquer tela ────────────────────────────
    // Path: tenants/{tenantId}/{collection}/{recordId}/{filename} — a coleção é o id da tela e só
    // existe em runtime, então o curinga vale para todas.
    //
    // `logs` fica de fora porque tem regra PRÓPRIA e mais estrita logo abaixo (só admin lê, ninguém
    // escreve) e, como o Storage libera quando qualquer regra libera, o curinga a afrouxaria. Pelo
    // mesmo motivo, `downloads`: o arquivo é pessoal (ou só de quem gerencia), quem grava e apaga é o
    // servidor, e quem baixa usa o link com token que a geração devolve — nenhum caminho pelo SDK. As
    // entidades fixas não precisam ser excluídas: o modelo de acesso delas é idêntico ao daqui.
    //
    // `portalUploads` é a área de ESPERA dos anexos do convidado do portal (regra própria abaixo): pelo
    // curinga, qualquer membro leria e gravaria nela.
    //
    // `branding` guarda o LOGO do escritório (regra própria abaixo): pelo curinga, qualquer membro o
    // trocaria — e o logo vai no topo do portal e de todo e-mail que o escritório envia.
    function isReservedStoragePath(collection) {
      return collection in ['logs', 'downloads', 'portalUploads', 'branding'];
    }

    //
    // Pelo SDK, o arquivo de um registro segue a PERMISSÃO da coleção dele, como o registro: lê quem tem
    // `<coleção>.read`, envia quem cria ou altera registros dela, apaga quem altera ou exclui. Antes,
    // qualquer membro lia o arquivo de qualquer tela — inclusive das que ele não pode abrir.
    //
    // Isto NÃO afeta o link de download (a URL com `token=` que o sistema guarda no documento): ele não
    // passa por regra nenhuma, e quem o tem abre o arquivo — é o que o portal e os e-mails usam, e o que
    // permite mandar o link a quem não tem conta.
    //
    // Documentos lidos por caminho (o teto é dois — ver "O ORÇAMENTO" acima):
    //   create — membro (1); SYSTEM: membro + users (2).
    //   read   — membro + tela (2); SYSTEM: membro + users (2), sem tela, porque ele vê todo registro.
    //            Sob `memberVisibility`, quem supervisiona continua em 2; quem só é NOMEADO no registro
    //            precisaria de 3 e é recusado — esse arquivo ele abre pelo link guardado no documento.
    //   delete — membro + tela (2), sem `editWindow` nem `memberVisibility`. Sob `memberVisibility`,
    //            quem supervisiona continua em 2. Fora isso o registro entra na conta (exista ou não):
    //            são 3, e a exclusão do arquivo é recusada.
    //            O SYSTEM que não é membro chega a 3 (membro + users + tela) e também é recusado.
    //            O cliente ignora essa recusa (o documento sai, o arquivo fica).
    match /tenants/{tenantId}/{collection}/{recordId}/{allPaths=**} {
      allow read: if request.auth != null
        && !isReservedStoragePath(collection)
        && ((memberCan(tenantId, collection + '.read') && memberSeesRecordFiles(tenantId, collection, recordId))
            || isSystemOrSupportUser());
      allow create: if request.auth != null
        && !isReservedStoragePath(collection)
        && resource == null
        && request.resource.size < 20 * 1024 * 1024     // máximo 20 MB
        && (memberCanEither(tenantId, collection + '.create', collection + '.update')
            || isSystemOrSupportUser());
      allow delete: if request.auth != null
        && !isReservedStoragePath(collection)
        && ((memberCanEither(tenantId, collection + '.update', collection + '.delete')
              && memberDeletesRecordFiles(tenantId, collection, recordId))
            || (isSystemOrSupportUser() && recordFilesUnlocked(tenantId, collection, recordId)));
    }

    // A visibilidade por registro (`memberVisibility`) vale para os ARQUIVOS do registro como vale para
    // ele: quem não lê o registro não baixa nem apaga o anexo dele pelo SDK. A mesma conta do
    // `firestore.rules` (`seesRecord`), lida dos mesmos dois documentos — o que não é mapa não nomeia
    // ninguém, os campos contam por posição, até quatro, e a supervisão é a declarada ou
    // `<coleção>.read-all`. Aqui o `multi` ganha a guarda `is list`, que lá não cabe: lá a regra tem de
    // PROVAR uma consulta, e aqui só responde por um arquivo. Enviar continua livre, como criar o registro: o arquivo de um registro novo
    // sobe ANTES de ele existir.
    //
    // A supervisão é perguntada ANTES do registro: ela sai do documento de membro, já lido, e poupa a
    // leitura do registro a quem supervisiona. O SYSTEM não passa por aqui — ele vê todo registro, e a
    // pergunta dele vem depois, no `match`.
    //
    // O link de download com `token=` continua fora de regra, como sempre: ele mora no documento e no
    // campo do registro, e é a regra DELES que o esconde de quem não lê.
    function memberSeesRecordFiles(tenantId, collection, recordId) {
      let screenPath = /databases/(default)/documents/tenants/$(tenantId)/screenDefinitions/$(collection);
      return !firestore.exists(screenPath)
        || memberSeesFilesUnder(firestore.get(screenPath).data, tenantId, collection, recordId);
    }
    function memberSeesFilesUnder(screen, tenantId, collection, recordId) {
      let spec = screen.get('memberVisibility', null);
      let recordPath = /databases/(default)/documents/tenants/$(tenantId)/$(collection)/$(recordId);
      return spec == null
        || memberCan(tenantId, fileBypassPermission(collection, spec))
        || (firestore.exists(recordPath) && fileRecordNamesMember(spec, firestore.get(recordPath).data));
    }
    // Apagar o arquivo pede VER o registro e a janela de edição ABERTA — numa pergunta só pela tela e
    // numa só pelo registro (ver "O ORÇAMENTO"). A cascata apaga o registro antes dos anexos: o arquivo
    // de um registro que não existe mais sai, sob qualquer declaração.
    function memberDeletesRecordFiles(tenantId, collection, recordId) {
      let screenPath = /databases/(default)/documents/tenants/$(tenantId)/screenDefinitions/$(collection);
      return !firestore.exists(screenPath)
        || memberDeletesFilesUnder(firestore.get(screenPath).data, tenantId, collection, recordId);
    }
    function memberDeletesFilesUnder(screen, tenantId, collection, recordId) {
      let spec = screen.get('memberVisibility', null);
      let windowSpec = screen.get('editWindow', null);
      let recordPath = /databases/(default)/documents/tenants/$(tenantId)/$(collection)/$(recordId);
      return (spec == null && windowSpec == null)
        || !firestore.exists(recordPath)
        || ((spec == null
              || memberCan(tenantId, fileBypassPermission(collection, spec))
              || fileRecordNamesMember(spec, firestore.get(recordPath).data))
            && (windowSpec == null
              || editWindowOpenSince(windowSpec, firestore.get(recordPath).data.get('createdAt', null))));
    }
    function fileBypassPermission(collection, spec) {
      return spec is map && spec.get('bypassPermission', null) is string
        ? spec.get('bypassPermission', null)
        : collection + '.read-all';
    }
    function fileVisibilityFields(spec) {
      return spec is map && spec.get('userFields', []) is list ? spec.get('userFields', []) : [];
    }
    function fileNamesMember(data, fields, index) {
      return fields.size() > index
        && fields[index] is string
        && (data.get(fields[index], null) == request.auth.uid
            || (data.get(fields[index], null) is list && data.get(fields[index], []).hasAny([request.auth.uid])));
    }
    function fileRecordNamesMember(spec, data) {
      let fields = fileVisibilityFields(spec);
      return fileNamesMember(data, fields, 0)
        || fileNamesMember(data, fields, 1)
        || fileNamesMember(data, fields, 2)
        || fileNamesMember(data, fields, 3);
    }

    // A janela de edição da tela (`editWindow`) vale para os ARQUIVOS do registro como vale para os
    // documentos dele no Firestore — a mesma conta, lida dos mesmos dois documentos. Fechada a janela
    // do registro, nenhum arquivo dele é apagado, nem pelo dono — e, como gravar por cima também é
    // recusado (`resource == null` no `create`), apagar e reenviar no mesmo caminho era a única forma
    // de trocar o conteúdo. A exceção é o registro que já não existe — a cascata o apaga antes dos anexos.
    function recordFilesUnlocked(tenantId, collection, recordId) {
      let screenPath = /databases/(default)/documents/tenants/$(tenantId)/screenDefinitions/$(collection);
      let recordPath = /databases/(default)/documents/tenants/$(tenantId)/$(collection)/$(recordId);
      return !firestore.exists(screenPath)
        || firestore.get(screenPath).data.get('editWindow', null) == null
        || !firestore.exists(recordPath)
        || editWindowOpenSince(firestore.get(screenPath).data.editWindow, firestore.get(recordPath).data.get('createdAt', null));
    }
    function editWindowOpenSince(spec, createdAt) {
      return spec.get('minutes', null) is int
        && spec.minutes > 0
        && createdAt is timestamp
        && request.time < createdAt + duration.value(spec.minutes, 'm');
    }

    // ─── Logo do escritório ──────────────────────────────────────────────────
    // Path: tenants/{tenantId}/branding/logo/{fileName}
    //
    // Envia quem ALTERA o escritório — o membro com `tenant.update` materializado em `permissions` (ou o
    // curinga `*`, que é o do dono), ou o SYSTEM, como no `can()` do Firestore —, só imagem e até 2 MB.
    // Cada envio é um arquivo NOVO: trocar ou
    // apagar o anterior quebraria o logo dos e-mails já enviados, que apontam para ele. O e-mail e o
    // portal abrem pela URL de download, que carrega o próprio token; a leitura aqui é a dos membros.
    // Documentos lidos: membro (1); SYSTEM, membro + users (2).
    function canChangeTenant(tenantId) {
      return canInTenant(tenantId, 'tenant.update');
    }

    match /tenants/{tenantId}/branding/logo/{fileName} {
      allow read: if request.auth != null && isTenantMemberOrElevated(tenantId);
      allow create: if request.auth != null
        && canChangeTenant(tenantId)
        && resource == null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // ─── Anexos do convidado do portal (área de espera) ─────────────────────
    // Path: tenants/{tenantId}/portalUploads/{userId}/{uploadId}
    //
    // O convidado só CRIA aqui, na pasta dele, e só enquanto o convite existe. Não lê, não troca e não
    // apaga — nunca: quem move o arquivo para o registro é a callable `attachPortalDocument`, depois de
    // conferir registro, tela e tipo, e é ela que limpa a espera. O limite é o mesmo do escritório.
    match /tenants/{tenantId}/portalUploads/{userId}/{uploadId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/portalUsers/$(userId))
        && resource == null
        && request.resource.size < 20 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    // ─── Backup frio de Logs de Auditoria ────────────────────────────────────
    // Path: tenants/{tenantId}/logs/{entity}/{logId}.json
    // Escrito somente pela Cloud Function backupDeletedAuditLog (Admin SDK).
    match /tenants/{tenantId}/logs/{entity}/{allPaths=**} {
      // Só o suporte do sistema: o `role == 'admin'` de antes não existia mais, e na prática já era só ele.
      allow read: if request.auth != null && isSystemOrSupportUser();
      allow write: if false;
    }
    // Path: systemLogs/{entity}/{logId}.json — logs sem tenant (erros globais do pipeline)
    match /systemLogs/{entity}/{allPaths=**} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'SYSTEM';
      allow write: if false;
    }

    // Bloqueia tudo o mais
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
