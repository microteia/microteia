# Modelo dos arquivos de ambiente do frontend. NÃO é lido pelo Vite.
#
# Crie um arquivo por ambiente, ambos fora do git:
#   .env.dev   -> projeto Firebase "microteia-dev"  (usado por `npm run dev` e pelo build padrão)
#   .env.prod  -> projeto Firebase "microteia"       (usado quando TARGET=prod)
#
# Não existe um `.env` comum de propósito: um valor faltando no arquivo do
# ambiente deve quebrar na hora, e não cair silenciosamente na configuração
# do outro projeto.
#
# Para obter os valores de um projeto:
#   npx firebase apps:sdkconfig web --project dev
#   npx firebase apps:sdkconfig web --project prod

VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=

# Client ID OAuth do Google, específico de cada projeto.
VITE_GOOGLE_CLIENT_ID=
