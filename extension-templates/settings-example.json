{
  "manifest": {
    "id": "com.microteia.settings-example",
    "version": "1.1.0",
    "kernel": "^2.22.0",
    "name": "@com.microteia.settings-example/package.name",
    "description": "@com.microteia.settings-example/package.description",
    "category": "@com.microteia.settings-example/package.category",
    "icon": "settings",
    "publisher": {
      "name": "Microteia"
    },
    "dependencies": {
      "core.ui": "^1.0.0"
    },
    "license": {
      "type": "stack",
      "gap": "md",
      "children": [
        {
          "type": "heading",
          "text": "@com.microteia.settings-example/licence.heading"
        },
        {
          "type": "markdown",
          "content": "@com.microteia.settings-example/licence.body"
        }
      ]
    },
    "contributes": [
      {
        "point": "i18n.messages",
        "id": "en.com.microteia.settings-example",
        "apiVersion": "1.0.0",
        "metadata": {
          "locale": "en",
          "namespace": "com.microteia.settings-example",
          "messages": {
            "package.name": "Configuration, by example",
            "package.category": "Configuration",
            "package.description": "A settings section with every kind of property the platform edits — and the licence terms this package asks the office to accept.",
            "package.summary": "How an extension is configured without bringing a screen for it. The Settings page is a generic host: it knows no setting in particular, and if nothing is contributed it is empty by definition. This package declares one section with each kind of property the editor knows how to draw, in both scopes, and carries the terms it asks the office to accept before installing.",
            "section.title": "Settings example",
            "section.description": "One of each kind of property, so the editor can be read rather than guessed.",
            "prop.enabled": "Enabled",
            "prop.enabled.description": "A switch. Both scopes, so a person may differ from the office default.",
            "prop.batch": "Batch size",
            "prop.batch.description": "A number with bounds. Office-wide only — it is about the installation, not about a person.",
            "prop.label": "Report heading",
            "prop.label.description": "Free text.",
            "prop.mode": "Mode",
            "prop.mode.description": "A closed list of choices.",
            "prop.mode.strict": "Strict",
            "prop.mode.lenient": "Lenient",
            "prop.stages": "Stages to show",
            "prop.stages.description": "Several options from a list the office owns. The value stored is each option key — the same a record stores.",
            "prop.owner": "Default contact",
            "prop.owner.description": "One record of a screen. The value stored is the record ID — the same a reference field stores.",
            "lookup.stages": "Example stages",
            "stage.open": "Open",
            "stage.waiting": "Waiting",
            "stage.done": "Done",
            "screen.contact": "Example contact",
            "screen.contact.plural": "Example contacts",
            "field.name": "Name",
            "field.email": "E-mail",
            "prop.senders": "Allowed senders",
            "prop.senders.description": "A list of texts, validated one item at a time. It exists so an extension that needs \"several addresses\" does not have to ask for a JSON blob.",
            "prop.senders.placeholder": "someone@example.com",
            "prop.extra": "Advanced",
            "prop.extra.description": "Anything the vocabulary above cannot say — the escape hatch, and the last resort.",
            "licence.heading": "Terms of the Settings example",
            "licence.body": "This example is provided as reading material, with no warranty of any kind. It stores no data of its own and sends nothing anywhere.\n\nTerms declared by an extension are ADDED to the ones Microteia already asks for — they never replace them."
          }
        }
      },
      {
        "point": "i18n.messages",
        "id": "pt-br.com.microteia.settings-example",
        "apiVersion": "1.0.0",
        "metadata": {
          "locale": "pt-BR",
          "namespace": "com.microteia.settings-example",
          "messages": {
            "package.name": "Configuração, pelo exemplo",
            "package.category": "Configuração",
            "package.description": "Uma seção de configurações com cada tipo de propriedade que a plataforma edita — e os termos de licença que este pacote pede que o escritório aceite.",
            "package.summary": "Como uma extensão é configurada sem trazer uma tela para isso. A tela de Configurações é um hospedeiro genérico: ela não conhece nenhuma configuração em particular, e se nada for contribuído ela está vazia por definição. Este pacote declara uma seção com um de cada tipo de propriedade que o editor sabe desenhar, nos dois escopos, e carrega os termos que pede que o escritório aceite antes de instalar.",
            "section.title": "Exemplo de configurações",
            "section.description": "Um de cada tipo de propriedade, para que o editor possa ser lido em vez de adivinhado.",
            "prop.enabled": "Ativado",
            "prop.enabled.description": "Um interruptor. Nos dois escopos, para que uma pessoa possa diferir do padrão do escritório.",
            "prop.batch": "Tamanho do lote",
            "prop.batch.description": "Um número com limites. Só do escritório — é sobre a instalação, não sobre uma pessoa.",
            "prop.label": "Título do relatório",
            "prop.label.description": "Texto livre.",
            "prop.mode": "Modo",
            "prop.mode.description": "Uma lista fechada de escolhas.",
            "prop.mode.strict": "Estrito",
            "prop.mode.lenient": "Tolerante",
            "prop.stages": "Etapas a mostrar",
            "prop.stages.description": "Várias opções de uma lista que é do escritório. O valor gravado é a chave de cada opção — a mesma que um registro grava.",
            "prop.owner": "Contato padrão",
            "prop.owner.description": "Um registro de uma tela. O valor gravado é o id do registro — o mesmo que um campo de referência grava.",
            "lookup.stages": "Etapas do exemplo",
            "stage.open": "Aberta",
            "stage.waiting": "Aguardando",
            "stage.done": "Concluída",
            "screen.contact": "Contato de exemplo",
            "screen.contact.plural": "Contatos de exemplo",
            "field.name": "Nome",
            "field.email": "E-mail",
            "prop.senders": "Remetentes permitidos",
            "prop.senders.description": "Uma lista de textos, validada item a item. Existe para que uma extensão que precisa de \"vários endereços\" não tenha de pedir um bloco de JSON.",
            "prop.senders.placeholder": "alguem@exemplo.com",
            "prop.extra": "Avançado",
            "prop.extra.description": "O que o vocabulário acima não diz — a saída de emergência, e o último recurso.",
            "licence.heading": "Termos do exemplo de configurações",
            "licence.body": "Este exemplo é material de leitura, sem garantia de espécie alguma. Ele não guarda dado próprio e não envia nada a lugar nenhum.\n\nOs termos declarados por uma extensão SOMAM-SE aos que a Microteia já pede — nunca os substituem."
          }
        }
      },
      {
        "point": "ui.settings",
        "id": "settings-example",
        "apiVersion": "1.0.0",
        "metadata": {
          "key": "settings-example",
          "title": "@com.microteia.settings-example/section.title",
          "description": "@com.microteia.settings-example/section.description",
          "icon": "settings",
          "order": 90,
          "properties": [
            {
              "key": "settingsExample.enabled",
              "label": "@com.microteia.settings-example/prop.enabled",
              "description": "@com.microteia.settings-example/prop.enabled.description",
              "type": "boolean",
              "default": true,
              "scopes": [
                "tenant",
                "user"
              ]
            },
            {
              "key": "settingsExample.batchSize",
              "label": "@com.microteia.settings-example/prop.batch",
              "description": "@com.microteia.settings-example/prop.batch.description",
              "type": "number",
              "default": 50,
              "min": 1,
              "max": 500,
              "scopes": [
                "tenant"
              ]
            },
            {
              "key": "settingsExample.heading",
              "label": "@com.microteia.settings-example/prop.label",
              "description": "@com.microteia.settings-example/prop.label.description",
              "type": "text",
              "default": "",
              "scopes": [
                "tenant"
              ]
            },
            {
              "key": "settingsExample.mode",
              "label": "@com.microteia.settings-example/prop.mode",
              "description": "@com.microteia.settings-example/prop.mode.description",
              "type": "select",
              "default": "strict",
              "options": [
                {
                  "value": "strict",
                  "label": "@com.microteia.settings-example/prop.mode.strict"
                },
                {
                  "value": "lenient",
                  "label": "@com.microteia.settings-example/prop.mode.lenient"
                }
              ],
              "scopes": [
                "tenant"
              ]
            },
            {
              "key": "settingsExample.stages",
              "label": "@com.microteia.settings-example/prop.stages",
              "description": "@com.microteia.settings-example/prop.stages.description",
              "type": "select",
              "multi": true,
              "optionsFrom": {
                "kind": "lookup",
                "collection": "settingsExampleStages"
              },
              "default": [
                "open",
                "waiting"
              ],
              "scopes": [
                "tenant",
                "user"
              ]
            },
            {
              "key": "settingsExample.owner",
              "label": "@com.microteia.settings-example/prop.owner",
              "description": "@com.microteia.settings-example/prop.owner.description",
              "type": "select",
              "optionsFrom": {
                "kind": "entity",
                "collection": "settingsExampleContact"
              },
              "default": "",
              "scopes": [
                "tenant"
              ]
            },
            {
              "key": "settingsExample.senders",
              "label": "@com.microteia.settings-example/prop.senders",
              "description": "@com.microteia.settings-example/prop.senders.description",
              "type": "stringList",
              "default": [],
              "itemPlaceholder": "@com.microteia.settings-example/prop.senders.placeholder",
              "itemPattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "scopes": [
                "tenant"
              ]
            },
            {
              "key": "settingsExample.advanced",
              "label": "@com.microteia.settings-example/prop.extra",
              "description": "@com.microteia.settings-example/prop.extra.description",
              "type": "json",
              "default": {},
              "scopes": [
                "tenant"
              ]
            }
          ]
        }
      }
    ]
  },
  "summary": "@com.microteia.settings-example/package.summary",
  "workflows": [],
  "screens": [
    {
      "key": "settingsExampleContact",
      "sourceId": "microteia:settings-example:contact",
      "sourceRev": 1,
      "titleSingular": "@com.microteia.settings-example/screen.contact",
      "titlePlural": "@com.microteia.settings-example/screen.contact.plural",
      "icon": "user",
      "fields": [
        {
          "key": "name",
          "label": "@com.microteia.settings-example/field.name",
          "type": "text",
          "required": true,
          "order": 0
        },
        {
          "key": "email",
          "label": "@com.microteia.settings-example/field.email",
          "type": "text",
          "required": false,
          "order": 1
        }
      ],
      "titleFieldKey": "name",
      "subtitleFieldKey": "email",
      "eventPrefix": "settingsExampleContact"
    }
  ],
  "lookups": [
    {
      "collection": "settingsExampleStages",
      "label": "@com.microteia.settings-example/lookup.stages",
      "options": [
        {
          "key": "open",
          "label": "@com.microteia.settings-example/stage.open",
          "color": "primary"
        },
        {
          "key": "waiting",
          "label": "@com.microteia.settings-example/stage.waiting",
          "color": "warning"
        },
        {
          "key": "done",
          "label": "@com.microteia.settings-example/stage.done",
          "color": "success"
        }
      ]
    }
  ]
}
