  "startup": "\nexport default function startup(host) {\n  host.mentions.register({\n    key: 'pessoa',\n    label: 'Pessoa',\n    description: 'Inserir link para uma pessoa',\n    icon: 'team',\n    search(query, ctx) {\n      const screen = ctx.screenDefinitions.find((s) => (s.sourceId || s.id) === 'microteia:pessoa');\n      if (!screen) return [];\n      const q = String(query || '').toLowerCase().trim();\n      const collection = screen.dataCollection || screen.id;\n      return ctx.records\n        .filter((r) => r.collection === collection)\n        .map((r) => ({ record: r, title: r[screen.titleFieldKey] }))\n        .filter(({ title }) => title && (!q || title.toLowerCase().indexOf(q) !== -1))\n        .slice(0, 20)\n        .map(({ record, title }) => ({\n          id: record.id,\n          title,\n          subtitle: record.type || 'Pessoa',\n          tabKey: 'view-dyn:' + screen.id + ':' + record.id,\n        }));\n    },\n  });\n}\n"
}
