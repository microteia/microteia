rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────────────

    // Retorna os dados do usuário autenticado na coleção users
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário autenticado é administrador global do sistema
    function isSystemAdmin() {
      return request.auth != null && userData().role == 'SYSTEM';
    }

    // Retorna os dados do membro do tenant
    function memberData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data;
    }

    // Tem documento em members/{uid} deste tenant. Separado de isMember() de propósito: é a condição
    // que precisa ser verdadeira ANTES de ler o documento, e o SYSTEM pode não ter um.
    function isTenantMember(tenantId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    // Verifica se o usuário é membro do tenant (ou SYSTEM, que conta como membro de todos)
    function isMember(tenantId) {
      return isSystemAdmin() || isTenantMember(tenantId);
    }

    // ─── A pergunta que substituiu "quem é você?" ─────────────────────────────
    //
    // `permissions` é o conjunto EFETIVO do membro, já com as dependências resolvidas. Ele é escrito
    // exclusivamente pelo Admin SDK (materializeMemberPermissions) e o cliente tem escrita negada
    // nele — resolver dependência aqui seria impossível, e materializar não custa nenhuma leitura a
    // mais: `memberData()` já era lido para saber o papel.
    //
    // `*` é o curinga do DONO do escritório. Ele não é um perfil e ninguém o atribui: sem ele um
    // escritório recém-criado nasceria sem nenhuma pessoa capaz de criar o primeiro perfil.
    function memberPermissions(tenantId) {
      return memberData(tenantId).get('permissions', []);
    }
    // O DONO do escritório, lido do próprio escritório e não do documento de membro.
    //
    // Ele é o último termo de propósito: para quem TEM a permissão, o `||` já respondeu e esta
    // leitura não acontece. E é lido de `Tenant.ownerId` — e não do curinga materializado — porque o
    // dono não pode depender de a Cloud Function de materialização já ter rodado: era exatamente
    // isso que deixava um escritório sem ninguém capaz de criar o primeiro perfil.
    function isTenantOwner(tenantId) {
      return request.auth != null
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid;
    }
    function can(tenantId, permission) {
      return isSystemAdmin()
        || (isTenantMember(tenantId) && memberPermissions(tenantId).hasAny([permission, '*']))
        || isTenantOwner(tenantId);
    }

    // ─── Usuários ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      // list: SYSTEM lista livremente (Gestão de Acessos, getUsers() sem limit()).
      // Qualquer outro autenticado só pode rodar consultas com limit() <= 1 — cobre a busca
      // exata por e-mail ao convidar membros (getUserByEmail usa limit(1)) sem permitir
      // dump da coleção inteira (emails/roles de todos os usuários) por um usuário comum.
      allow list: if isSystemAdmin()
        || (request.auth != null && request.query.limit <= 1);
      // O próprio documento é criado pela Cloud Function onUserCreated (Admin SDK,
      // trigger de Auth), nunca pelo client — por isso create é sempre negado aqui.
      allow create: if false;
      // Nenhum campo é editável pelo frontend fora da role, e só por SYSTEM. tenantIds e
      // qualquer outro campo são mantidos pelas Cloud Functions addTenantMember/removeTenantMember
      // (Admin SDK, ignoram estas regras) — o client não tem mais nenhum caminho de escrita
      // cross-user em users/{userId}.
      allow update: if isSystemAdmin();
    }

    // ─── Perfis de usuário ────────────────────────────────────────────────────
    
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow list: if isSystemAdmin()
        || (request.auth != null && request.query.limit <= 1);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Nicknames (unicidade) ────────────────────────────────────────────────

    match /nicknames/{nickname} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Uma coleção de RAIZ que só o servidor toca não ganha bloco aqui, e é de propósito: o Firestore
    // nega o que nenhuma regra libera, então `allow read, write: if false` não acrescenta nada — só dá a
    // impressão de que a proteção mora aqui. Este arquivo já teve um bloco assim, nomeando uma coleção
    // de extensão; quem escrevia e lia era o Admin SDK, nas callables da própria extensão. Extensão que
    // precise de coleção só-servidor não precisa de regra: precisa de nenhuma.

    // ─── Tenants (escritórios) ────────────────────────────────────────────────  

    match /tenants/{tenantId} {
      // Qualquer membro pode ler o tenant
      allow get: if isMember(tenantId);
      // list: só o SYSTEM lista a coleção inteira — a aba "Escritórios" de Gestão de Acessos e o
      // seletor de escritório do TopBar, que para ele exibe todos em vez de só os que é membro.
      // Sem esta regra, getDocs(collection('tenants')) é negado — "get" não cobre consultas de coleção.
      allow list: if isSystemAdmin();
      // Quem tem `tenant.update` altera os dados do escritório, mas nunca memberCount/memberLimit/ownerId/plan.
      // memberCount só é escrito pelas Cloud Functions addTenantMember/removeTenantMember (Admin SDK,
      // ignora estas regras); memberLimit e plan só por admin global (SYSTEM), na aba "Escritórios" de Gestão de Acessos.
      allow update: if isSystemAdmin()
        || (can(tenantId, 'tenant.update')
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount', 'memberLimit', 'ownerId', 'plan']));
      // Tenant é criado pela Cloud Function onUserCreated (Admin SDK, trigger de Auth)
      // junto com o bootstrap do usuário — nunca pelo client.
      allow create: if false;
      allow delete: if false;

      // ─── Acessos de agente de IA ─────────────────────────────────────────────
      // O DONO do acesso lê o seu; quem tem `agent.manage` lê os de todos, porque é ele quem
      // responde por revogar o de alguém que saiu.
      //
      // A ESCRITA é `false` para todo cliente, sem exceção, e não por rigor: o segredo tem de ser
      // sorteado no servidor, e o documento só pode nascer com o HASH dele. Uma escrita direta
      // permitiria gravar um `secretHash` escolhido — e quem escolhe o hash escolhe o token.
      // São as callables `createAgentGrant` / `revokeAgentGrant` que gravam, pelo Admin SDK.
      match /agentGrants/{grantId} {
        // `isMember` PRIMEIRO, e ele não é redundante com o resto: sem ele, quem SAIU do escritório
        // continuaria lendo o acesso que emitiu enquanto era membro, porque o `userId` do documento
        // ainda casa com o uid dele. Todo o resto do produto é escopado por participação, e um
        // documento que responde a ex-membro seria a única exceção.
        allow read: if isMember(tenantId)
          && (resource.data.userId == request.auth.uid || can(tenantId, 'agent.manage'));
        allow write: if false;
      }

      // Conexões de IA do escritório — quem tem `ai.manage` lê e escreve
      match /aiConnections/{connectionId} {
        allow read, write: if can(tenantId, 'ai.manage');

        // Chave de API: pode ser ESCRITA (cadastro/troca), mas NUNCA LIDA.
        // Cloud Functions (Admin SDK) leem a chave, ignorando estas regras.
        match /secrets/{secretId} {
          allow read: if false;                  // Frontend NUNCA lê a chave
          allow write: if can(tenantId, 'ai.manage');
        }
      }

      // ─── Perfis de acesso ────────────────────────────────────────────────────
      // TODO membro lê, e isso não é frouxidão: cada navegador resolve as próprias permissões a
      // partir daqui, e sem a leitura ninguém saberia o que pode fazer. O que é secreto não é a
      // existência do perfil — é a capacidade de alterá-lo.
      //
      // `system` nunca é gravado pelo cliente: um perfil protegido não nasce nem se torna protegido
      // por uma tela, e o protegido que existir não é alterável nem excluível por aqui.
      match /roles/{roleId} {
        allow read: if isMember(tenantId);
        allow create: if can(tenantId, 'roles.manage')
          && request.resource.data.get('system', false) == false;
        allow update: if can(tenantId, 'roles.manage')
          && resource.data.get('system', false) == false
          && request.resource.data.get('system', false) == false;
        allow delete: if can(tenantId, 'roles.manage')
          && resource.data.get('system', false) == false;
      }

      // Membros do tenant
      match /members/{memberId} {
        // Membros leem a lista de membros do próprio tenant
        allow read: if isMember(tenantId);
        // Criação e exclusão passam pelas Cloud Functions addTenantMember/removeTenantMember
        // (Admin SDK, ignoram estas regras) — garante que o limite de membros do tenant
        // (memberLimit/memberCount) nunca seja ultrapassado, mesmo por escritas diretas do client
        // ou por duas adições concorrentes (dois admins, dois computadores, ao mesmo tempo).
        allow create, delete: if false;
        // Atribuir perfis continua sendo escrita direta do client — não mexe no contador de membros.
        // `permissions` é o conjunto materializado, e o cliente NUNCA o escreve: fosse editável aqui,
        // bastaria uma escrita no próprio documento para se conceder qualquer coisa.
        //
        // `permissionsCatalog` é a digital do catálogo com que aquele conjunto foi composto, e é
        // negada pelo MESMO motivo por tabela: quem pudesse carimbá-la à mão diria que o conjunto
        // está em dia, e a recomposição que o corrigiria nunca mais seria pedida.
        allow update: if can(tenantId, 'members.manage')
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['permissions', 'permissionsCatalog']);
      }

      // Tipos de documento — a lista compartilhada por toda tela que anexa arquivo
      match /documentTypes/{id} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'document-types.manage');
      }

      // ─── Workflow Engine (Automações) ────────────────────────────────────────
      // Definições de automação — feature administrativa; só admin cria/edita/exclui.
      // `steps` fica embutido no próprio documento (ver "Workflow Engine" no corpo do doc).
      // Workflows públicos (isPublic === true) podem ser lidos por qualquer tenant autenticado
      // para permitir cópia (ver "Workflows Públicos" no corpo do doc).
      match /workflow_definitions/{workflowId} {
        allow read: if request.auth != null && 
        (isMember(tenantId) || resource.data.isPublic == true);
        allow create, update, delete: if can(tenantId, 'automation.manage');
      }

      // Scripts reutilizáveis executados pelo Step "Script" (sandbox QuickJS) — feature
      // administrativa; só admin cria/edita/exclui. Ver "Step Script" no corpo do doc.
      match /scripts/{scriptId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'automation.manage');
      }

      // Ações customizadas exibidas nas telas de dados (botão -> workflow síncrono).
      // Todo membro lê (precisa montar os botões da tela); só admin configura.
      // Ver "Actions Customizadas" no corpo do doc.
      match /actions/{actionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'automation.manage');
      }

      // Relatórios do escritório. Todo membro LÊ a definição — a lista precisa mostrar o que existe,
      // e a definição não é o dado: executar um relatório cobra, no servidor, a leitura de cada
      // coleção que ele toca. Só quem gerencia relatórios escreve.
      match /reports/{reportId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'reports.manage');
      }

      // Extensões PRIVADAS do escritório (criadas na tela "Criar extensão"). Todo membro lê —
      // as ativas contribuem telas/menu no Kernel do tenant; só admin cria/edita/remove.
      //
      // A origem `imported` não se desfaz: a extensão importada tem a fonte com quem a escreveu, e
      // regravá-la como `authored` seria editá-la por um caminho que a tela não oferece. Reimportar
      // (versão nova do autor) mantém `imported` e passa; ligar/desligar não toca a origem.
      match /extensions/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, delete: if can(tenantId, 'extensions.manage');
        allow update: if can(tenantId, 'extensions.manage')
          && (resource.data.get('origin', '') != 'imported'
              || request.resource.data.get('origin', '') == 'imported');
      }

      // Extensões INSTALADAS (cópias fiéis da área pública ou de uma privada). Todo membro lê — as
      // ativas contribuem no Kernel; só admin instala/atualiza/desinstala. Independentes da fonte.
      match /installed_extensions/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'extensions.manage');
      }

      // Histórico de MIGRAÇÃO DE DADOS das extensões: o que cada uma já converteu neste escritório.
      // Todo membro lê — é o que mantém fora do boot a extensão com migração obrigatória em dívida, e
      // sem essa leitura cada navegador a carregaria sobre dado no formato antigo. Só admin grava, o
      // mesmo papel que instala e que a callable de execução exige. Sobrevive à desinstalação de
      // propósito: o dado migrado sobrevive, então reinstalar não pode reexecutar tudo de novo.
      match /extension_migrations/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update: if can(tenantId, 'extensions.manage');
        allow delete: if false;
      }

      // O recálculo dos agregados sobre os registros que já existiam (um documento por tela pai).
      // Todo membro lê: é daqui que a listagem tira o aviso de uma passada bloqueada ou com falhas, e o
      // que o documento expõe — nomes de campo, contagens, ids — quem lê a tela já vê. Ninguém grava
      // do cliente: o cursor, a reserva e o registro do que foi recalculado são do servidor, e um
      // cliente que os escrevesse poderia dar por recalculado o que não foi.
      match /aggregate_backfills/{table} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // Histórico de VERSÕES APLICADAS das extensões: o que este escritório já pôs no ar de cada uma,
      // e o que ele pode reaplicar. Todo membro lê, como em `installed_extensions` — o pacote guardado
      // aqui é o mesmo que já está exposto lá, então não há exposição nova; só admin grava, porque
      // gravar aqui é o mesmo ato de instalar.
      //
      // O índice fica no documento e o PACOTE de cada entrada na subcoleção `versions`: assinar dez
      // pacotes por extensão a cada carga da aplicação custaria megabytes, e o índice estouraria o
      // 1 MiB do Firestore antes da quarta versão de um pacote de tradução.
      //
      // Ao contrário de `extension_migrations`, aqui `delete` é PERMITIDO: desinstalar preserva o
      // histórico (é dele que sai a última versão instalada), mas EXCLUIR a extensão o apaga junto —
      // não sobra a quem ele sirva.
      match /extension_history/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'extensions.manage');

        match /versions/{revision} {
          allow read: if isMember(tenantId);
          allow create, update, delete: if can(tenantId, 'extensions.manage');
        }
      }

      // Configurações declaradas por plugins. Dois documentos, e o caminho decide quem grava:
      // `tenant` é o padrão do escritório (só admin) e `user_{uid}` é a preferência pessoal, que só
      // o dono escreve. Todo membro LÊ os dois — a resolução (usuário vence escritório) acontece no
      // cliente, e sem ler o padrão ninguém saberia o que herdar.
      match /settings/{settingsDocId} {
        allow read: if isMember(tenantId);
        allow create, update: if settingsDocId == 'tenant'
          ? can(tenantId, 'settings.manage')
          : settingsDocId == 'user_' + request.auth.uid && isMember(tenantId);
        allow delete: if can(tenantId, 'settings.manage');
      }

      // Event Bus do motor — qualquer membro com escrita pode publicar um evento;
      // coleção append-only, ninguém lê/edita/exclui pelo client (só a Cloud Function
      // onWorkflowEventCreated, via Admin SDK, que ignora estas regras).
      match /workflow_events/{eventId} {
        // Sem `actor`: QUEM disparou é gravado só pelo Admin SDK, ao lado do payload. Aceitá-lo do
        // cliente deixaria qualquer membro com `automation.run` executar um fluxo em nome de outro — e o
        // registro que o fluxo gravasse sairia com o autor forjado.
        allow create: if can(tenantId, 'automation.run')
          && !('actor' in request.resource.data);
        allow read, update, delete: if false;
      }

      // Histórico de execução — só a Cloud Function grava (Admin SDK); membros só leem.
      match /workflow_executions/{executionId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // ─── Listas de opções declaradas pelo tenant ─────────────────────────────
      // O gêmeo, do lado do Firestore, do LOOKUP_REGISTRY de código. O id do documento É o nome da
      // coleção onde as opções ficam, e é este `exists()` que autoriza a escrita nela lá embaixo.
      match /lookupDefinitions/{lookupCollection} {
        allow read: if isMember(tenantId);
        // Declarar uma lista é ato de Form Design; instalar uma extensão que traz uma também é —
        // e as duas portas são legítimas, por isso as duas permissões valem.
        allow create, update, delete: if can(tenantId, 'screens.manage')
          || can(tenantId, 'extensions.manage');
      }

      // ─── Conjuntos de etiquetas declarados pelo tenant ───────────────────────
      // Mesmo papel de lookupDefinitions: o id do documento É o nome da coleção onde as etiquetas
      // ficam, e é este `exists()` que autoriza a escrita nela lá embaixo.
      match /tagDefinitions/{tagCollection} {
        allow read: if isMember(tenantId);
        // Declarar uma lista é ato de Form Design; instalar uma extensão que traz uma também é —
        // e as duas portas são legítimas, por isso as duas permissões valem.
        allow create, update, delete: if can(tenantId, 'screens.manage')
          || can(tenantId, 'extensions.manage');
      }

      // ─── Telas Dinâmicas (Personalização) ────────────────────────────────────
      // Definições de telas e campos customizados — membro lê; só admin configura
      match /screenDefinitions/{screenId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'screens.manage')
          || can(tenantId, 'extensions.manage');
      }

      // ─── Registros de qualquer tela ─────────────────────────────────────────
      // Uma tela É uma coleção: `tenants/{tenantId}/medico/{id}`. O nome só existe em runtime
      // (o usuário cria a tela no Form Design), então não há como listá-lo aqui — daí o curinga.
      //
      // A lista de reservadas é OBRIGATÓRIA: o Firestore avalia todas as regras que casam e libera
      // se qualquer uma liberar. Sem ela, este bloco anularia as regras mais estritas acima
      // (workflow_executions com `write: if false`, members sem create/delete). É espelho de
      // RESERVED_COLLECTIONS em domain/schema/screenEntity.ts,
      // e o teste screenEntity.test.ts compara as duas pontas.
      //
      // A ESCRITA exige ainda que exista a tela declarada, para que nenhuma coleção inventada
      // receba dados. A LEITURA dispensa a checagem: coleção sem tela está vazia, e cobrar uma
      // leitura de documento por consulta não pagaria o que protege.
      function isReservedCollection(name) {
        return name in [
        'actions', 'agentGrants', 'aggregate_backfills', 'aiConnections',
        'documentTypes', 'documents', 'extension_history', 'extension_migrations', 'extensions',
        'installed_extensions', 'lookupDefinitions', 'members', 'notes',
        'reports', 'roles',
        // `plugin_installations` não tem mais código que a leia — foi a instalação de antes de
        // `installed_extensions`. Continua RESERVADA porque os documentos de então continuam nos
        // escritórios, e liberar o nome deixaria uma tela nova nascer por cima deles.
        'tagDefinitions', 'plugin_installations',
        'recordKeys',
        'screenDefinitions', 'scripts', 'secrets', 'settings', 'tags', 'tenant', 'workflow_definitions',
        'workflow_events', 'workflow_executions'
        ];
      }
      function isDeclaredScreen(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name));
      }
      // Uma lista de opções também é uma coleção que só existe em runtime, e cai neste mesmo
      // curinga — dois `match` com o mesmo padrão não são permitidos. Daí a segunda condição.
      function isDeclaredLookup(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/lookupDefinitions/$(name));
      }
      function isDeclaredTagList(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/tagDefinitions/$(name));
      }
      function isWritableScreen(name) {
        return !isReservedCollection(name)
          && (isDeclaredScreen(name) || isDeclaredLookup(name) || isDeclaredTagList(name));
      }
      // Quem grava numa coleção de tela é quem tem a PERMISSÃO dela — `medico.create`,
      // `medico.update`, `medico.delete`. O nome não está escrito em lugar nenhum: ele é montado a
      // partir da própria coleção, que é o que faz esta regra valer para uma tela criada no Form
      // Design cinco minutos atrás.
      //
      // Aqui morava `writeRoles`, a lista de papéis que a tela declarava. Ela resolvia o problema
      // certo — a tela decidindo quem grava nela — com o vocabulário errado: para alargar o acesso
      // de um mural era preciso nomear `user`, um papel que o produto impunha ao escritório. A
      // permissão derivada diz a mesma coisa sem nomear papel nenhum.
      function screenData(name) {
        return get(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name)).data;
      }
      function screenList(name, field) {
        return screenData(name).get(field, []) is list ? screenData(name).get(field, []) : [];
      }
      function canOnCollection(name, action) {
        return can(tenantId, name + '.' + action);
      }
      // Campos que QUALQUER membro grava, mesmo sem permissão de escrita na tela: o "por usuário" de
      // um mural — marcar como lida, curtir, guardar para depois. São gravações no documento que
      // OUTRA pessoa criou, e por isso o limite é a própria lista: a alteração é recusada se tocar
      // em qualquer campo fora dela. `updatedAt` entra porque o repositório sempre o carimba.
      function screenMemberWritableFields(name) {
        return screenList(name, 'memberWritableFields');
      }
      function touchesOnlyMemberWritableFields(name) {
        return isDeclaredScreen(name)
          && screenMemberWritableFields(name).size() > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(screenMemberWritableFields(name).concat(['updatedAt', 'updatedVia']));
      }
      // A tela que declara `authorCanDelete` deixa quem escreveu apagar o que escreveu, mesmo sem a
      // permissão de exclusão da coleção: ali a autoria É a posse — um comentário, um recado.
      function screenAuthorCanDelete(name) {
        return isDeclaredScreen(name)
          && get(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name))
               .data.get('authorCanDelete', false) == true;
      }
      function isRecordAuthor() {
        return resource.data.get('createdBy', '') == request.auth.uid;
      }
      // POR ONDE a gravação entrou (`createdVia`/`updatedVia`). O cliente só pode dizer `ui`: `agent` e
      // `automation` são escritos pelo Admin SDK, e é esta regra que impede uma tela — ou uma extensão
      // rodando nela — de fazer um registro digitado passar por gravado pela IA, ou o contrário.
      function declaresOnlyUiOnCreate() {
        return request.resource.data.get('createdVia', 'ui') == 'ui'
          && request.resource.data.get('updatedVia', 'ui') == 'ui';
      }
      // A marca do RECÁLCULO de agregados (`updatedVia: 'aggregate-backfill'`) é o que faz uma
      // gravação passar sem evento `.saved` e sem auditoria. Ela fica no documento depois do
      // recálculo, e por isso não basta proibir o cliente de ESCREVÊ-LA: um update que não tocasse em
      // `updatedVia` a herdaria. O cliente só deixa um registro marcado assim no carimbo de exclusão
      // (`deletedBy*`), que é a única gravação dele que não carimba `updatedVia: 'ui'` — e que não
      // passaria pela marca, porque não mexe em campo derivado.
      function keepsWriteViaOnUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['createdVia'])
          && (!changed.hasAny(['updatedVia']) || request.resource.data.updatedVia == 'ui')
          && (request.resource.data.get('updatedVia', 'ui') != 'aggregate-backfill'
              || changed.hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL']));
      }

      // Uma LISTA DE OPÇÕES e um CONJUNTO DE ETIQUETAS são vocabulário, não dado: toda tela que os
      // referencia precisa deles para desenhar um `select` ou um chip, e exigir permissão de leitura
      // própria só produziria a tela meio carregada de quem tem acesso ao registro mas não à lista
      // que ele cita. GRAVAR neles continua exigindo a permissão da coleção, como em tudo o mais.
      function isDeclaredVocabulary(name) {
        return isDeclaredLookup(name) || isDeclaredTagList(name);
      }

      // ─── Reservas de chave (unicidade) ──────────────────────────────────────
      //
      // AQUI mora a garantia, e ela não é um "conferir antes de gravar".
      //
      // A gravação de um registro com chave é um LOTE: o documento mais uma reserva por chave, cujo
      // ID é derivado do valor. Este bloco libera `create` e não libera `update` — e `create`, no
      // Firestore, só dispara quando o documento NÃO existe. Escrever sobre uma reserva ocupada é um
      // `update` para a regra, é negado, e o lote inteiro falha atomicamente. Não há janela entre
      // conferir e gravar: duas gravações no mesmo instante não passam as duas.
      //
      // É a mesma forma de `/nicknames`, que já vivia neste arquivo para um caso só. E não pede
      // índice nenhum: a busca é por id de documento — a razão de preferir a reserva a consultar
      // antes de gravar, que além da corrida exigiria um índice por chave declarada.
      //
      // O que este arquivo NÃO consegue conferir: que o valor reservado é o valor gravado. A regra é
      // estática e as chaves são dado de runtime — um `match` genérico não computa um id derivado de
      // uma lista de campos que ele não conhece. Essa metade é cobrada nos dois pontos de gravação
      // (`recordRulesGate` no front, `runWorkflowUpsert` no backend), que é o mesmo patamar de
      // `required`, máscara e `rules.validate`. Ver "Chave primária e chave única" no ARCHITECTURE.md.
      match /recordKeys/{keyId} {
        // Ler a reserva é o que permite ao front dizer QUAL valor colidiu em vez de "acesso negado".
        allow read: if isMember(tenantId);
        allow create: if isWritableScreen(request.resource.data.get('collection', ''))
          && (canOnCollection(request.resource.data.collection, 'create')
              || canOnCollection(request.resource.data.collection, 'update'))
          && request.resource.data.keys().hasOnly(['collection', 'keyName', 'recordId', 'values', 'createdAt'])
          && request.resource.data.recordId is string
          && request.resource.data.keyName is string
          && request.resource.data.values is list;
        // Sem `update`, de propósito: é a ausência dele que faz o `create` ser a trava.
        allow delete: if canOnCollection(resource.data.get('collection', ''), 'update')
          || canOnCollection(resource.data.get('collection', ''), 'delete');
      }

      match /{screenCollection}/{recordId} {
        allow read: if !isReservedCollection(screenCollection)
          && isMember(tenantId)
          && (canOnCollection(screenCollection, 'read') || isDeclaredVocabulary(screenCollection));
        allow create: if isWritableScreen(screenCollection)
          && canOnCollection(screenCollection, 'create')
          && declaresOnlyUiOnCreate();
        allow update: if isWritableScreen(screenCollection)
          && keepsWriteViaOnUpdate()
          && (canOnCollection(screenCollection, 'update')
              || (isMember(tenantId) && touchesOnlyMemberWritableFields(screenCollection)));
        allow delete: if isWritableScreen(screenCollection)
          && (canOnCollection(screenCollection, 'delete')
              || (canOnCollection(screenCollection, 'update')
                  && screenAuthorCanDelete(screenCollection)
                  && isRecordAuthor()));

        // Anotações do registro: seguem a permissão da COLEÇÃO DO PAI — a nota é parte do registro,
        // não uma entidade com acesso próprio. `update` só carimba a autoria de exclusão.
        match /notes/{noteId} {
          allow read: if !isReservedCollection(screenCollection)
            && isMember(tenantId)
            && canOnCollection(screenCollection, 'read');
          allow create: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'update');
          allow update: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL'])
            && request.resource.data.deletedBy == request.auth.uid;
          allow delete: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete');
        }

        // Documentos do registro — mesmo modelo das anotações
        match /documents/{documentId} {
          allow read: if !isReservedCollection(screenCollection)
            && isMember(tenantId)
            && canOnCollection(screenCollection, 'read');
          allow create: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'update');
          allow update: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL'])
            && request.resource.data.deletedBy == request.auth.uid;
          allow delete: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete');
        }
      }
    }

    // ─── Filtros salvos ───────────────────────────────────────────────────────

    match /savedFilters/{filterId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ─── Logs de Auditoria ────────────────────────────────────────────────────
    // Coleção flat na raiz (não subcoleção de tenant). Escrita bloqueada para
    // todos os clientes — somente Cloud Functions (Admin SDK) criam documentos.

    match /auditLogs/{logId} {
      allow read: if request.auth != null && can(resource.data.tenantId, 'audit.read');
      allow write: if false;
    }

    // ─── Cursor de leitura da Auditoria ───────────────────────────────────────
    // Doc id: `${userId}_${tenantId}`. Guarda só `lastReadAt` — usado para
    // calcular o badge de falhas CRITICAL não lidas (ver "Badge de falhas
    // críticas não lidas" no módulo de Auditoria). Mesmo padrão de savedFilters.

    match /auditLogReadCursors/{cursorId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ─── Catálogo de Steps do Workflow Engine ─────────────────────────────────
    // Coleção flat na raiz, global (não por tenant) — o catálogo de Steps disponíveis é o
    // mesmo para todos os escritórios. Espelho somente-leitura de StepDefinition (sem
    // `createExecutor`), escrito só pelo composition root em functions/ (Admin SDK).
    match /workflow_step_catalog/{stepDefinitionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // O que o provisionamento deixou para trás no projeto: Cloud Function e índice composto de
    // extensão que nenhum escritório instalou mais. Coleção flat na raiz porque a órfã é um fato do
    // PROJETO, não de um escritório — guardá-la por tenant seria a mesma resposta N vezes, com N
    // maneiras de divergir. Escrita SÓ pelo Microteia Console (credencial de administrador, que não
    // passa por estas regras); o cliente nunca escreve.
    //
    // Leitura para qualquer autenticado, como nas outras duas coleções globais. O documento é o
    // inventário de backend do projeto — nome de function e id de extensão —, e não carrega dado de
    // escritório nenhum. É ele que faz a tela de Extensões poder avisar quem não tem acesso ao projeto
    // Firebase de que há artefato a retirar, que é o único motivo de ele existir.
    match /backend_state/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Catálogo global de extensões publicadas pelos escritórios (modelo npm/VS Code). É a FRONTEIRA
    // de integridade da publicação — o app não usa Cloud Function aqui. É ESTE o catálogo da tela de
    // Extensões. Ver "Como uma extensão chega ao catálogo" no ARCHITECTURE.md.
    // - Qualquer autenticado lê.
    // - Publicar (create/update): o dono publica o que NÃO traz código, sempre 'approved'; com código,
    //   só SYSTEM. create só existe quando o doc não existe → domínio único global.
    // - Trocar de dono, aprovar e obsoletar: só SYSTEM.
    // - Apagar: só SYSTEM (o dono usa 'deprecated', não apaga do catálogo).
    match /public_extensions/{domain} {
      function pkgHasCode() {
        return ('views' in request.resource.data.package)
          && request.resource.data.package.views.size() > 0;
      }
      // Extensão COM código roda no navegador de todo membro de todo escritório que a instalar: quem a
      // põe no catálogo é só a equipe global. Sem código o pacote é declaração, e quem administra o
      // escritório DONO publica direto — já aprovada, porque não há terceiro a quem consultar.
      function ownerPublishing() {
        return !pkgHasCode() && request.resource.data.status == 'approved';
      }
      allow read: if request.auth != null;
      allow create: if isSystemAdmin()
        || (can(request.resource.data.ownerTenantId, 'extensions.manage') && ownerPublishing());
      // Republicar = upsert: um identificador tem UM registro público, e o dono sobrescreve os
      // próprios dados. Trocar de dono, aprovar, obsoletar e publicar código são do SYSTEM.
      allow update: if isSystemAdmin()
        || (can(resource.data.ownerTenantId, 'extensions.manage')
            && request.resource.data.ownerTenantId == resource.data.ownerTenantId
            && ownerPublishing());
      allow delete: if isSystemAdmin();
    }

    // ─── Reputação de extensão — instalações e estrelas ────────────────────────
    // O agregado é escrito SÓ pelo Admin SDK (countExtensionInstalls, aggregateExtensionRatings). Ele
    // não mora em `public_extensions` porque o dono reescreve aquele documento a cada republicação, e
    // um número que o autor pode gravar não diz nada a quem lê.
    match /extension_stats/{pluginId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Um escritório que instalou: marcador da contagem. Nenhum cliente lê nem escreve — a lista
      // diria quais escritórios usam o quê.
      match /installs/{tenantId} {
        allow read, write: if false;
      }

      // Um voto por pessoa (id = uid), e só de quem é membro de um escritório que tem a extensão
      // instalada a partir do catálogo. A cópia privada não vota: o voto criaria o agregado com o
      // identificador de algo que nunca foi publicado.
      match /ratings/{userId} {
        function installedFromCatalog(tenantId, extensionId) {
          let installed = /databases/$(database)/documents/tenants/$(tenantId)/installed_extensions/$(extensionId);
          return exists(installed) && get(installed).data.get('source', 'public') != 'private';
        }
        function validVote(vote, extensionId) {
          return vote.keys().hasOnly(['stars', 'tenantId', 'updatedAt'])
            && vote.stars is int && vote.stars >= 1 && vote.stars <= 5
            && vote.tenantId is string
            && vote.updatedAt == request.time
            && isTenantMember(vote.tenantId)
            && installedFromCatalog(vote.tenantId, extensionId);
        }
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && validVote(request.resource.data, pluginId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Publicador verificado ─────────────────────────────────────────────────
    // Id = o escritório que publica. A verificação é do PUBLICADOR, e não da versão: republicar não a
    // apaga, e o dono não a concede a si mesmo — o nome que ele grava em `public_extensions` é livre,
    // e o selo existe justamente para não depender dele.
    match /extension_publishers/{tenantId} {
      allow read: if request.auth != null;
      allow create, update: if isSystemAdmin()
        && request.resource.data.keys().hasOnly(['verified', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.verified == true
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time;
      allow delete: if isSystemAdmin();
    }

    // ─── Pedidos de autorização de OAuth ───────────────────────────────────────
    // FECHADA para todo cliente, nas duas direções, e esta é a regra inteira.
    //
    // De raiz e não dentro de `tenants` porque, quando o documento nasce, ainda não há escritório:
    // quem chega é um navegador anônimo vindo do `/authorize`, e escolher o escritório é parte do
    // consentimento. Fechá-la não é excesso — o documento guarda o hash do código de autorização, e
    // quem lê o hash não tem o código, mas quem ESCREVE escolhe qual código vale. O navegador chega
    // ao que precisa por callable, filtrado, e nunca ao `codeHash`.
    match /agentAuthRequests/{requestId} {
      allow read, write: if false;
    }

  }
}
