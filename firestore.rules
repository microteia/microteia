rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────────────

    // Retorna os dados do usuário autenticado na coleção users
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário autenticado é administrador global do sistema
    function isSystemAdmin() {
      return request.auth != null && userData().role == 'SYSTEM';
    }

    // Retorna os dados do membro do tenant
    function memberData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data;
    }

    // Tem documento em members/{uid} deste tenant — e NADA MAIS. É o pertencimento cru: serve só ao que
    // precisa ser lido ANTES de a sessão provar o segundo fator (o próprio escritório, no seletor, e o
    // próprio documento de membro, que diz se o fator é exigido). Todo o resto pergunta isTenantMember.
    function belongsToTenant(tenantId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    // ─── Segundo fator (EV-07) ────────────────────────────────────────────────
    //
    // `mfa` é a exigência MATERIALIZADA no documento de membro pela mesma rotina das permissões
    // (`materializeMemberPermissions`), a partir da política do escritório. Ausente ou nula: não
    // exigido — é o que mantém intacto o escritório que nunca ligou a política.
    //
    // `mfaAt` é a claim que o servidor põe na SESSÃO (createCustomToken) quando o código confere: o
    // instante da verificação, em segundos. Claim de sessão, e não de usuário: a sessão aberta só com a
    // senha não a tem, mesmo que a pessoa tenha provado o fator em outro aparelho.
    //
    // LER exige ter provado; GRAVAR exige ter provado há menos de `maxAgeSeconds`. É o que permite pedir
    // o código de novo sem derrubar as assinaturas de leitura da tela aberta. A mesma conta mora em
    // `mfaSessionIssue` (domain/schema/memberMfa.ts), que as callables usam.
    function sessionSatisfiesMfa(member) {
      let requirement = member.get('mfa', null);
      let verifiedAt = request.auth.token.get('mfaAt', 0);
      return requirement == null
        || (verifiedAt is number && verifiedAt > 0
            && (request.method in ['get', 'list']
                || request.time.toMillis() < (verifiedAt + requirement.maxAgeSeconds) * 1000));
    }

    // Membro deste tenant COM a sessão que o escritório exige dele. Separado de isMember() de propósito:
    // é a condição que precisa ser verdadeira ANTES de ler o documento, e o SYSTEM pode não ter um.
    // A leitura do documento é a mesma do exists() — e a mesma que memberPermissions() faz —, então o
    // segundo fator não custa leitura nenhuma a mais.
    //
    // O SYSTEM que É membro não é alcançado pela política do escritório — a mesma decisão de can() e de
    // `assertMemberSession` nas callables. O `mfa` continua materializado no documento dele (a política
    // o alcança como alcança qualquer um); quem o dispensa é a pergunta, aqui, e só quando a sessão
    // falharia: não custa leitura a quem já passou, e a conta rebaixada a USER volta a ser cobrada no
    // instante, sem esperar materialização nenhuma (EV-36).
    function isTenantMember(tenantId) {
      return belongsToTenant(tenantId)
        && (sessionSatisfiesMfa(memberData(tenantId)) || isSystemAdmin());
    }

    // Verifica se o usuário é membro do tenant (ou SYSTEM, que conta como membro de todos)
    function isMember(tenantId) {
      return isSystemAdmin() || isTenantMember(tenantId);
    }

    // ─── A pergunta que substituiu "quem é você?" ─────────────────────────────
    //
    // `permissions` é o conjunto EFETIVO do membro, já com as dependências resolvidas. Ele é escrito
    // exclusivamente pelo Admin SDK (materializeMemberPermissions) e o cliente tem escrita negada
    // nele — resolver dependência aqui seria impossível, e materializar não custa nenhuma leitura a
    // mais: `memberData()` já era lido para saber o papel.
    //
    // `*` é o curinga do DONO do escritório. Ele não é um perfil e ninguém o atribui: sem ele um
    // escritório recém-criado nasceria sem nenhuma pessoa capaz de criar o primeiro perfil.
    function memberPermissions(tenantId) {
      return memberData(tenantId).get('permissions', []);
    }
    // O DONO do escritório, lido do próprio escritório e não do documento de membro.
    //
    // Ele é o último termo de propósito: para quem TEM a permissão, o `||` já respondeu e esta
    // leitura não acontece. E é lido de `Tenant.ownerId` — e não do curinga materializado — porque o
    // dono não pode depender de a Cloud Function de materialização já ter rodado: era exatamente
    // isso que deixava um escritório sem ninguém capaz de criar o primeiro perfil.
    //
    // O curinga do dono não pula o segundo fator: a política por permissão o alcança (ele detém todas), e
    // a exigência dele mora no MESMO documento de membro que o bootstrap cria para ele.
    function isTenantOwner(tenantId) {
      return request.auth != null
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid
        && (!belongsToTenant(tenantId) || sessionSatisfiesMfa(memberData(tenantId)));
    }
    // O prefixo gravado em `settings/tenant` — '' quando o documento ou a chave não existem.
    function tenantPrefixOf(doc) {
      return doc == null ? '' : doc.data.get('values', {}).get('customization.prefix', '');
    }

    function tenantPrefixWriteAllowed(tenantId) {
      let after = tenantPrefixOf(request.resource);
      return after == tenantPrefixOf(resource)
        || (can(tenantId, 'tenant.change-prefix') && after is string && after.matches('^[a-z][a-z0-9]{1,7}$'));
    }

    // O convidado do PORTAL. Não é membro, e é de propósito: nenhuma regra `isMember` o deixa passar,
    // então tudo o que o escritório guarda continua fechado para ele sem que regra nenhuma mude. O que
    // ele lê é a projeção (`portalRecords`), e só a que o carimba no `audience`.
    //
    // Ler o documento dele em cada consulta é o que torna a revogação IMEDIATA: o `audience` é refeito
    // por um gatilho, alguns segundos depois; a exclusão do convite vale no instante.
    //
    // O convite SUSPENSO não abre nada: é o de quem entra pelo link de e-mail num escritório que
    // desligou esse método (Configurações › Portal › Entrada). A suspensão mora no convite, e não numa
    // configuração lida aqui, para que a pergunta continue custando UMA leitura.
    function isPortalUser(tenantId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/portalUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)/portalUsers/$(request.auth.uid)).data.get('suspended', false) != true;
    }
    function isInPortalAudience(tenantId) {
      return request.auth != null
        && request.auth.uid in resource.data.audience
        && isPortalUser(tenantId);
    }
    // O registro PÚBLICO (`subject: 'public'`) é de todo convidado ativo do escritório: não tem
    // `audience`, e a consulta que o lista é provada por `public == true`. O convite continua sendo lido
    // a cada consulta — revogar e suspender fecham o público também, no instante.
    function isPortalPublicRecord(tenantId) {
      return resource.data.public == true
        && isPortalUser(tenantId);
    }

    function can(tenantId, permission) {
      return isSystemAdmin()
        || (isTenantMember(tenantId) && memberPermissions(tenantId).hasAny([permission, '*']))
        || isTenantOwner(tenantId);
    }

    // ─── Usuários ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      // list: SYSTEM lista livremente (Gestão de Acessos, getUsers() sem limit()).
      // Qualquer outro autenticado só pode rodar consultas com limit() <= 1 — cobre a busca
      // exata por e-mail ao convidar membros (getUserByEmail usa limit(1)) sem permitir
      // dump da coleção inteira (emails/roles de todos os usuários) por um usuário comum.
      allow list: if isSystemAdmin()
        || (request.auth != null && request.query.limit <= 1);
      // O próprio documento é criado pela Cloud Function onUserCreated (Admin SDK,
      // trigger de Auth), nunca pelo client — por isso create é sempre negado aqui.
      allow create: if false;
      // Nenhum campo é editável pelo frontend fora da role, e só por SYSTEM. tenantIds e
      // qualquer outro campo são mantidos pelas Cloud Functions addTenantMember/removeTenantMember
      // (Admin SDK, ignoram estas regras) — o client não tem mais nenhum caminho de escrita
      // cross-user em users/{userId}.
      allow update: if isSystemAdmin();
    }

    // ─── Push no navegador ────────────────────────────────────────────────────
    // Os aparelhos em que a pessoa aceitou notificação. O aparelho é DELA, e não do escritório: a
    // inscrição vale para todo escritório de que ela participa, e quem decide se um deles a alcança é
    // a preferência dela naquele escritório. Só ela lê e grava. O servidor faz um POST para o
    // `endpoint`, então ele só aceita `https` — sem isso, a inscrição seria uma forma de pôr a
    // function para chamar um endereço interno.
    match /users/{userId}/push_subscriptions/{subscriptionId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'userAgent', 'createdAt'])
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() < 2048
        && request.resource.data.endpoint.matches('^https://[^/]+/.*')
        && request.resource.data.keys is map;
    }

    // ─── Perfis de usuário ────────────────────────────────────────────────────
    
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow list: if isSystemAdmin()
        || (request.auth != null && request.query.limit <= 1);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Nicknames (unicidade) ────────────────────────────────────────────────

    match /nicknames/{nickname} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ─── Contas novas da instalação ───────────────────────────────────────────
    // Se a conta nova pode existir e se ganha escritório próprio. Só o SYSTEM lê e muda (Gestão de
    // Acessos › Usuários). O ÚNICO documento de `system/` que alguma regra alcança: `system/bootstrap`
    // continua só do Admin SDK. Campo ausente vale `true`. Ver `domain/schema/registration.ts`.
    match /system/registration {
      allow get: if isSystemAdmin();
      allow create, update: if isSystemAdmin()
        && request.resource.data.keys().hasOnly(['acceptNewAccounts', 'selfServiceTenants', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('acceptNewAccounts', true) is bool
        && request.resource.data.get('selfServiceTenants', true) is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // A recusa que o gatilho de criação grava antes de apagar a conta: só quem foi recusado a lê, e é
    // ela que a tela de entrada usa para explicar o motivo. Escrita só pelo servidor; expira por TTL.
    match /registrationRefusals/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
    }

    // Uma coleção de RAIZ que só o servidor toca não ganha bloco aqui, e é de propósito: o Firestore
    // nega o que nenhuma regra libera, então `allow read, write: if false` não acrescenta nada — só dá a
    // impressão de que a proteção mora aqui. Este arquivo já teve um bloco assim, nomeando uma coleção
    // de extensão; quem escrevia e lia era o Admin SDK, nas callables da própria extensão. Extensão que
    // precise de coleção só-servidor não precisa de regra: precisa de nenhuma.

    // ─── Tenants (escritórios) ────────────────────────────────────────────────  

    match /tenants/{tenantId} {
      // Qualquer membro pode ler o tenant — mesmo antes de provar o segundo fator: é o nome do escritório
      // no seletor e na tela que pede o código. Nada do que o escritório guarda está neste documento.
      allow get: if isSystemAdmin() || belongsToTenant(tenantId);
      // list: só o SYSTEM lista a coleção inteira — a aba "Escritórios" de Gestão de Acessos e o
      // seletor de escritório do TopBar, que para ele exibe todos em vez de só os que é membro.
      // Sem esta regra, getDocs(collection('tenants')) é negado — "get" não cobre consultas de coleção.
      allow list: if isSystemAdmin();
      // Quem tem `tenant.update` altera os dados do escritório, mas nunca memberCount/memberLimit/ownerId/plan.
      // memberCount só é escrito pelas Cloud Functions addTenantMember/removeTenantMember (Admin SDK,
      // ignora estas regras); memberLimit e plan só por admin global (SYSTEM), na aba "Escritórios" de Gestão de Acessos.
      allow update: if isSystemAdmin()
        || (can(tenantId, 'tenant.update')
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount', 'memberLimit', 'ownerId', 'plan']));
      // Tenant é criado pela Cloud Function onUserCreated (Admin SDK, trigger de Auth)
      // junto com o bootstrap do usuário — nunca pelo client.
      allow create: if false;
      allow delete: if false;

      // ─── Acessos de agente de IA ─────────────────────────────────────────────
      // O DONO do acesso lê o seu; quem tem `agent.manage` lê os de todos, porque é ele quem
      // responde por revogar o de alguém que saiu.
      //
      // A ESCRITA é `false` para todo cliente, sem exceção, e não por rigor: o segredo tem de ser
      // sorteado no servidor, e o documento só pode nascer com o HASH dele. Uma escrita direta
      // permitiria gravar um `secretHash` escolhido — e quem escolhe o hash escolhe o token.
      // São as callables `createAgentGrant` / `revokeAgentGrant` que gravam, pelo Admin SDK.
      match /agentGrants/{grantId} {
        // `isMember` PRIMEIRO, e ele não é redundante com o resto: sem ele, quem SAIU do escritório
        // continuaria lendo o acesso que emitiu enquanto era membro, porque o `userId` do documento
        // ainda casa com o uid dele. Todo o resto do produto é escopado por participação, e um
        // documento que responde a ex-membro seria a única exceção.
        allow read: if isMember(tenantId)
          && (resource.data.userId == request.auth.uid || can(tenantId, 'agent.manage'));
        // Apagar só o que já não autentica — revogado, ou com o CONSENTIMENTO vencido. É limpeza da
        // lista, não um segundo caminho de revogação: o acesso ativo continua passando pela callable,
        // e o vencimento do token curto do OAuth (`accessExpiresAt`) não conta, porque o refresh o
        // renova. O `delete` não grava campo nenhum, então não reabre a escolha do `secretHash`.
        allow delete: if isMember(tenantId)
          && (resource.data.userId == request.auth.uid || can(tenantId, 'agent.manage'))
          && (resource.data.get('revokedAt', null) != null
            || (resource.data.get('expiresAt', null) != null
              && resource.data.expiresAt <= request.time));
        allow create, update: if false;
      }

      // Conexões de IA do escritório — quem tem `ai.manage` lê e escreve
      match /aiConnections/{connectionId} {
        allow read, write: if can(tenantId, 'ai.manage');

        // Chave de API: pode ser ESCRITA (cadastro/troca), mas NUNCA LIDA.
        // Cloud Functions (Admin SDK) leem a chave, ignorando estas regras.
        match /secrets/{secretId} {
          allow read: if false;                  // Frontend NUNCA lê a chave
          allow write: if can(tenantId, 'ai.manage');
        }
      }

      // Credenciais de integração do passo "Chamar API". A DESCRIÇÃO (chave, esquema, domínios) é lida
      // também por quem monta automações — o editor lista as chaves para escolher; o SEGREDO é escrito
      // por quem gerencia integrações e nunca lido pelo navegador. Cloud Functions (Admin SDK) leem.
      match /httpConnections/{connectionId} {
        allow read: if can(tenantId, 'integrations.manage') || can(tenantId, 'automation.manage');
        allow write: if can(tenantId, 'integrations.manage');

        match /secrets/{secretId} {
          allow read: if false;
          allow write: if can(tenantId, 'integrations.manage');
        }
      }

      // A fila do passo "Chamar API" no modo assíncrono: o pedido já montado, com os valores que a
      // automação resolveu. Só o servidor lê e grava — nem quem gerencia automações, porque o pedido
      // carrega dado de registro que a pessoa talvez não veja. O resultado chega pelo callback.
      match /http_dispatches/{dispatchId} {
        allow read, write: if false;
      }

      // ─── Perfis de acesso ────────────────────────────────────────────────────
      // TODO membro lê, e isso não é frouxidão: cada navegador resolve as próprias permissões a
      // partir daqui, e sem a leitura ninguém saberia o que pode fazer. O que é secreto não é a
      // existência do perfil — é a capacidade de alterá-lo.
      //
      // `system` nunca é gravado pelo cliente: um perfil protegido não nasce nem se torna protegido
      // por uma tela, e o protegido que existir não é alterável nem excluível por aqui.
      match /roles/{roleId} {
        allow read: if isMember(tenantId);
        allow create: if can(tenantId, 'roles.manage')
          && request.resource.data.get('system', false) == false;
        allow update: if can(tenantId, 'roles.manage')
          && resource.data.get('system', false) == false
          && request.resource.data.get('system', false) == false;
        allow delete: if can(tenantId, 'roles.manage')
          && resource.data.get('system', false) == false;
      }

      // Membros do tenant
      match /members/{memberId} {
        // Membros leem a lista de membros do próprio tenant. O PRÓPRIO documento se lê sempre: é por ele
        // que o navegador sabe que o escritório exige o segundo fator — antes de a sessão tê-lo provado.
        allow read: if isMember(tenantId);
        allow get: if request.auth != null && request.auth.uid == memberId;
        // Criação e exclusão passam pelas Cloud Functions addTenantMember/removeTenantMember
        // (Admin SDK, ignoram estas regras) — garante que o limite de membros do tenant
        // (memberLimit/memberCount) nunca seja ultrapassado, mesmo por escritas diretas do client
        // ou por duas adições concorrentes (dois admins, dois computadores, ao mesmo tempo).
        allow create, delete: if false;
        // Atribuir perfis continua sendo escrita direta do client — não mexe no contador de membros.
        // `permissions` é o conjunto materializado, e o cliente NUNCA o escreve: fosse editável aqui,
        // bastaria uma escrita no próprio documento para se conceder qualquer coisa.
        //
        // `permissionsCatalog` é a digital do catálogo com que aquele conjunto foi composto, e é
        // negada pelo MESMO motivo por tabela: quem pudesse carimbá-la à mão diria que o conjunto
        // está em dia, e a recomposição que o corrigiria nunca mais seria pedida.
        //
        // `mfa` é a exigência de segundo fator, materializada pelo mesmo servidor e pelo mesmo motivo:
        // quem pudesse apagá-la do próprio documento entraria só com a senha.
        allow update: if can(tenantId, 'members.manage')
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['permissions', 'permissionsCatalog', 'mfa']);
      }

      // ─── Portal ──────────────────────────────────────────────────────────────
      // Quem é de FORA do escritório. Só o servidor grava (as callables de convite e revogação), e o
      // convidado lê o próprio convite — é dele que a casca do portal tira o nome do escritório.
      match /portalUsers/{portalUserId} {
        allow read: if (request.auth != null && request.auth.uid == portalUserId)
          || can(tenantId, 'portal.manage');
        allow create, update, delete: if false;
      }

      // O convite por IDENTIDADE — o atributo que a pessoa terá de provar e os sujeitos a que ele dá
      // acesso. Só o servidor grava (as callables de convite e revogação, e a entrada por provedor);
      // quem administra o portal lê, para listá-lo. O convidado não: o convite dele é `portalUsers`.
      match /portalIdentityInvites/{inviteId} {
        allow read: if can(tenantId, 'portal.manage');
        allow write: if false;
      }

      // A PROJEÇÃO do que cada tela expõe: só os campos declarados, carimbada com quem pode ver. A
      // consulta do portal filtra por `audience array-contains uid`, e é isso que deixa a regra provar
      // a lista sem ler documento nenhum — a mesma forma de Downloads. Ninguém grava do cliente: quem
      // escrevesse o `audience` daria a si mesmo o registro de outro.
      match /portalRecords/{projectionId} {
        allow read: if isInPortalAudience(tenantId) || isPortalPublicRecord(tenantId);
        allow write: if false;

        // O documento compartilhado não leva o `audience` consigo: a regra o lê do registro-pai. Uma
        // cópia por documento seria uma segunda coisa para o gatilho manter em dia — e a que ficasse
        // para trás manteria aberto o arquivo de quem já perdeu o registro.
        match /documents/{documentId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)/portalRecords/$(projectionId)).data.get('audience', [])
            && isPortalUser(tenantId);
          allow write: if false;
        }
      }

      // Tipos de documento — a lista compartilhada por toda tela que anexa arquivo. Quem instala uma
      // extensão também CRIA opções aqui: é a semeadura dela (`lookups[].options`), porque o kernel não
      // traz tipo nenhum. Alterar e apagar continua sendo de quem gere a lista.
      match /documentTypes/{id} {
        allow read: if isMember(tenantId);
        allow create: if can(tenantId, 'document-types.manage') || can(tenantId, 'extensions.manage');
        allow update, delete: if can(tenantId, 'document-types.manage');
      }

      // ─── Workflow Engine (Automações) ────────────────────────────────────────
      // Definições de automação — feature administrativa; só admin cria/edita/exclui.
      // `steps` fica embutido no próprio documento (ver "Workflow Engine" no corpo do doc).
      // Workflows públicos (isPublic === true) podem ser lidos por qualquer tenant autenticado
      // para permitir cópia (ver "Workflows Públicos" no corpo do doc).
      match /workflow_definitions/{workflowId} {
        allow read: if request.auth != null && 
        (isMember(tenantId) || resource.data.isPublic == true);
        allow create, update, delete: if can(tenantId, 'automation.manage');
      }

      // Scripts reutilizáveis executados pelo Step "Script" (sandbox QuickJS) — feature
      // administrativa; só admin cria/edita/exclui. Ver "Step Script" no corpo do doc.
      match /scripts/{scriptId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'automation.manage');
      }

      // Ações customizadas exibidas nas telas de dados (botão -> workflow síncrono).
      // Todo membro lê (precisa montar os botões da tela); só admin configura.
      // Ver "Actions Customizadas" no corpo do doc.
      match /actions/{actionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'automation.manage');
      }

      // Relatórios do escritório. Todo membro LÊ a definição — a lista precisa mostrar o que existe,
      // e a definição não é o dado: executar um relatório cobra, no servidor, a leitura de cada
      // coleção que ele toca. Só quem gerencia relatórios escreve.
      match /reports/{reportId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'reports.manage');
      }

      // Modelos de documento do escritório, um por CHAVE (o id do documento é a chave). Todo membro
      // LÊ: o gesto "Gerar documento" lista os modelos da tela, e o modelo não é o dado — gerar cobra,
      // no servidor, a edição do registro. Só quem gerencia modelos escreve.
      match /documentTemplates/{templateKey} {
        allow read: if isMember(tenantId);
        allow create, update: if can(tenantId, 'document-templates.manage')
          && request.resource.data.key == templateKey;
        allow delete: if can(tenantId, 'document-templates.manage');
      }

      // Downloads — os arquivos gerados que NÃO foram anexados a um registro. Quem grava é só o
      // servidor (a geração); o cliente lê e apaga, e o gatilho `onDownloadDeleted` leva o arquivo do
      // bucket junto. A visibilidade é carimbada na gravação, para a regra decidir pelo próprio
      // documento: o dono vê o seu, `everyone` (público — automação sem pessoa por configuração do
      // escritório, ou marcado por quem gerencia) vê todo membro, e `downloads.manage` vê tudo. A consulta da tela filtra por `ownerId` ou por
      // `visibility`, e é isso que deixa a regra provar a lista sem ler documento nenhum.
      match /downloads/{downloadId} {
        allow read: if (isMember(tenantId)
            && (resource.data.ownerId == request.auth.uid || resource.data.visibility == 'everyone'))
          || can(tenantId, 'downloads.manage');
        // Apagar é do dono e de quem gerencia. Ver não basta: tornar um arquivo público não pode
        // entregar a todo membro o poder de apagá-lo.
        allow delete: if (isMember(tenantId) && resource.data.ownerId == request.auth.uid)
          || can(tenantId, 'downloads.manage');
        // Tornar público ou privado é gesto de quem gerencia, e só muda a visibilidade. "Privado" volta
        // ao dono quando há um, e a quem gerencia quando não há (automação sem pessoa): tornar privado
        // nunca esconde o arquivo de quem o gerou.
        allow update: if can(tenantId, 'downloads.manage')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility'])
          && (request.resource.data.visibility == 'everyone'
              || (resource.data.ownerId != null && request.resource.data.visibility == 'owner')
              || (resource.data.ownerId == null && request.resource.data.visibility == 'managers'));
        allow create: if false;
      }

      // Extensões PRIVADAS do escritório (criadas na tela "Criar extensão"). Todo membro lê —
      // as ativas contribuem telas/menu no Kernel do tenant; só admin cria/edita/remove.
      //
      // A origem `imported` não se desfaz: a extensão importada tem a fonte com quem a escreveu, e
      // regravá-la como `authored` seria editá-la por um caminho que a tela não oferece. Reimportar
      // (versão nova do autor) mantém `imported` e passa; ligar/desligar não toca a origem.
      match /extensions/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, delete: if can(tenantId, 'extensions.manage');
        allow update: if can(tenantId, 'extensions.manage')
          && (resource.data.get('origin', '') != 'imported'
              || request.resource.data.get('origin', '') == 'imported');
      }

      // Extensões INSTALADAS (cópias fiéis da área pública ou de uma privada). Todo membro lê — as
      // ativas contribuem no Kernel; só admin instala/atualiza/desinstala. Independentes da fonte.
      match /installed_extensions/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'extensions.manage');
      }

      // Histórico de MIGRAÇÃO DE DADOS das extensões: o que cada uma já converteu neste escritório.
      // Todo membro lê — é o que mantém fora do boot a extensão com migração obrigatória em dívida, e
      // sem essa leitura cada navegador a carregaria sobre dado no formato antigo. Só admin grava, o
      // mesmo papel que instala e que a callable de execução exige. Sobrevive à desinstalação de
      // propósito: o dado migrado sobrevive, então reinstalar não pode reexecutar tudo de novo.
      match /extension_migrations/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update: if can(tenantId, 'extensions.manage');
        allow delete: if false;
      }

      // O recálculo dos agregados sobre os registros que já existiam (um documento por tela pai).
      // Todo membro lê: é daqui que a listagem tira o aviso de uma passada bloqueada ou com falhas, e o
      // que o documento expõe — nomes de campo, contagens, ids — quem lê a tela já vê. Ninguém grava
      // do cliente: o cursor, a reserva e o registro do que foi recalculado são do servidor, e um
      // cliente que os escrevesse poderia dar por recalculado o que não foi.
      match /aggregate_backfills/{table} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // Os jobs da busca (`domain/schema/recordSearch.ts`): a listagem lê o backfill da própria
      // coleção para saber se precisa pedir a conferência. Só o Admin SDK grava.
      match /record_search_jobs/{jobId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // A reprojeção do portal depois que uma declaração mudou (um documento por coleção). Lê quem
      // decide o que sai do escritório — o que o documento expõe são nomes de coleção, contagens e
      // ids. Ninguém grava do cliente: o cursor e a reserva são do servidor, e um cliente que os
      // escrevesse poderia dar por refeita a passada que ainda tem projeção para apagar.
      match /portal_reprojections/{collection} {
        allow read: if can(tenantId, 'portal.manage');
        allow write: if false;
      }

      // O texto do portal EDITADO pelo escritório (`portal.content`): um documento por referência de
      // mensagem (`<namespace>:<chave>`), com o texto de cada idioma. Só quem tem a permissão lê e grava —
      // o convidado recebe o texto pelo servidor, nunca daqui. A referência gravada tem de ser a do id:
      // sem isso, dois documentos disputariam a mesma chave. A exclusão é "voltar ao texto do pacote", e
      // antes dela vem o carimbo de quem excluiu (`deletedBy*`), que a Auditoria lê.
      match /portalTexts/{textId} {
        allow read, delete: if can(tenantId, 'portal.content');
        allow create, update: if can(tenantId, 'portal.content')
          && request.resource.data.keys().hasOnly([
            'ref', 'texts', 'updatedAt', 'updatedBy', 'updatedByName', 'updatedByPhotoURL',
            'deletedBy', 'deletedByName', 'deletedByPhotoURL'
          ])
          && request.resource.data.ref is string
          && request.resource.data.ref == '@' + textId.replace(':', '/')
          && request.resource.data.texts is map
          && request.resource.data.texts.size() <= 20;
      }

      // A adoção das chaves sobre os registros que já existiam (um documento por coleção). Todo
      // membro lê — a listagem tira dele o aviso, e o que ele expõe (nomes de chave, ids, os valores
      // repetidos) quem lê a coleção já vê. Ninguém grava do cliente: quem escrevesse `adopted` daria
      // por única uma chave com duplicatas embaixo dela.
      match /record_key_adoptions/{collection} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // O job de cada importação em massa (um documento por importação executada): totais, as primeiras
      // linhas recusadas e quem importou. Ninguém lê nem grava do cliente — a tela recebe tudo pela
      // callable `importRecords`, e um cliente que gravasse os totais faria a linha de Auditoria da
      // importação contar o que não aconteceu.
      match /record_imports/{importId} {
        allow read, write: if false;
      }

      // Histórico de VERSÕES APLICADAS das extensões: o que este escritório já pôs no ar de cada uma,
      // e o que ele pode reaplicar. Todo membro lê, como em `installed_extensions` — o pacote guardado
      // aqui é o mesmo que já está exposto lá, então não há exposição nova; só admin grava, porque
      // gravar aqui é o mesmo ato de instalar.
      //
      // O índice fica no documento e o PACOTE de cada entrada na subcoleção `versions`: assinar dez
      // pacotes por extensão a cada carga da aplicação custaria megabytes, e o índice estouraria o
      // 1 MiB do Firestore antes da quarta versão de um pacote de tradução.
      //
      // Ao contrário de `extension_migrations`, aqui `delete` é PERMITIDO: desinstalar preserva o
      // histórico (é dele que sai a última versão instalada), mas EXCLUIR a extensão o apaga junto —
      // não sobra a quem ele sirva.
      match /extension_history/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if can(tenantId, 'extensions.manage');

        match /versions/{revision} {
          allow read: if isMember(tenantId);
          allow create, update, delete: if can(tenantId, 'extensions.manage');
        }
      }

      // Configurações declaradas por plugins. Dois documentos, e o caminho decide quem grava:
      // `tenant` é o padrão do escritório (só admin) e `user_{uid}` é a preferência pessoal, que só
      // o dono escreve. Todo membro LÊ os dois — a resolução (usuário vence escritório) acontece no
      // cliente, e sem ler o padrão ninguém saberia o que herdar.
      //
      // O PREFIXO do escritório (`customization.prefix`) mora no mesmo documento, mas não é preferência:
      // é o começo de todo nome que o escritório cria. Mudá-lo — ou apagá-lo junto com o documento —
      // cobra `tenant.change-prefix`, e o valor novo tem de estar no formato de `artifactPrefix.ts`.
      match /settings/{settingsDocId} {
        allow read: if isMember(tenantId);
        //
        // `portal` é a home do PORTAL — boas-vindas, ordem do menu e dos widgets. Quem a configura é quem
        // decide o que sai do escritório (`portal.manage`), e não quem configura o escritório: as duas
        // permissões costumam estar em mãos diferentes. O convidado não a lê; o servidor a entrega.
        allow create, update: if settingsDocId == 'tenant'
          ? can(tenantId, 'settings.manage') && tenantPrefixWriteAllowed(tenantId)
          : settingsDocId == 'portal'
            ? can(tenantId, 'portal.manage')
            : settingsDocId == 'user_' + request.auth.uid && isMember(tenantId);
        allow delete: if settingsDocId == 'portal'
          ? can(tenantId, 'portal.manage')
          : can(tenantId, 'settings.manage')
            && (tenantPrefixOf(resource) == '' || can(tenantId, 'tenant.change-prefix'));
      }

      // O sino — as notificações que o passo `notify` entrega, uma por destinatário. Só o servidor
      // cria (Admin SDK). Cada pessoa lê as SUAS — a consulta precisa filtrar por `recipientId`, ou a
      // regra a recusa inteira — e só pode marcá-las como lidas: título, mensagem e destinatário são
      // do fluxo que as enviou, e reescrevê-los seria forjar um aviso. `isTenantMember`, e não
      // `isMember`, na escrita: quem saiu do escritório não tem mais o que marcar ali.
      //
      // O convidado do portal lê e marca os SEUS avisos ao portal (`audience == 'portal'`), e só
      // enquanto o convite existe — a consulta dele precisa filtrar pelos dois campos. Um aviso de
      // membro nunca chega a ele, nem que o `recipientId` coincida.
      match /notification_inbox/{notificationId} {
        allow read: if resource.data.recipientId == request.auth.uid
          && (isMember(tenantId) || (resource.data.audience == 'portal' && isPortalUser(tenantId)));
        allow update: if resource.data.recipientId == request.auth.uid
          && (isTenantMember(tenantId) || (resource.data.audience == 'portal' && isPortalUser(tenantId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if false;
      }

      // Event Bus do motor — qualquer membro com escrita pode publicar um evento;
      // coleção append-only, ninguém lê/edita/exclui pelo client (só a Cloud Function
      // onWorkflowEventCreated, via Admin SDK, que ignora estas regras).
      match /workflow_events/{eventId} {
        // Sem `actor`: QUEM disparou é gravado só pelo Admin SDK, ao lado do payload. Aceitá-lo do
        // cliente deixaria qualquer membro com `automation.run` executar um fluxo em nome de outro — e o
        // registro que o fluxo gravasse sairia com o autor forjado.
        // Sem `target` pelo mesmo motivo: o alvo acorda UMA automação sem passar pelo gatilho dela, e só
        // o relógio do kernel o escreve.
        // Nem `audit.recorded`: o evento de auditoria só nasce de um log gravado pelo Admin SDK, e um
        // forjado pelo cliente dispararia o alerta de um log que não existe.
        allow create: if can(tenantId, 'automation.run')
          && !('actor' in request.resource.data)
          && !('target' in request.resource.data)
          && request.resource.data.name != 'audit.recorded';
        allow read, update, delete: if false;
      }

      // Relógio das automações temporais — o próximo disparo de cada uma. Só o kernel o calcula (Admin
      // SDK); membros leem para o editor mostrar quando a automação roda de novo.
      match /workflow_clock/{definitionId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // Histórico de execução — só a Cloud Function grava (Admin SDK); membros só leem.
      match /workflow_executions/{executionId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // ─── Listas de opções declaradas pelo tenant ─────────────────────────────
      // O gêmeo, do lado do Firestore, do LOOKUP_REGISTRY de código. O id do documento É o nome da
      // coleção onde as opções ficam, e é este `exists()` que autoriza a escrita nela lá embaixo.
      match /lookupDefinitions/{lookupCollection} {
        allow read: if isMember(tenantId);
        // Declarar uma lista é ato de Form Design; instalar uma extensão que traz uma também é —
        // e as duas portas são legítimas, por isso as duas permissões valem.
        allow create, update, delete: if can(tenantId, 'screens.manage')
          || can(tenantId, 'extensions.manage');
      }

      // ─── Conjuntos de etiquetas declarados pelo tenant ───────────────────────
      // Mesmo papel de lookupDefinitions: o id do documento É o nome da coleção onde as etiquetas
      // ficam, e é este `exists()` que autoriza a escrita nela lá embaixo.
      match /tagDefinitions/{tagCollection} {
        allow read: if isMember(tenantId);
        // Declarar uma lista é ato de Form Design; instalar uma extensão que traz uma também é —
        // e as duas portas são legítimas, por isso as duas permissões valem.
        allow create, update, delete: if can(tenantId, 'screens.manage')
          || can(tenantId, 'extensions.manage');
      }

      // ─── Telas Dinâmicas (Personalização) ────────────────────────────────────
      // Definições de telas e campos customizados — membro lê; só admin configura
      //
      // O `portal` da tela decide o que SAI do escritório, e por isso não é ato de Form Design comum:
      // declará-lo ou mudá-lo cobra `portal.manage` — ou `extensions.manage`, que é quem instala o
      // pacote que o traz. Sem isto, quem só desenha telas poderia expor a coleção inteira a quem é de
      // fora, e a aba que a tela esconde não protegeria nada.
      match /screenDefinitions/{screenId} {
        allow read: if isMember(tenantId);
        allow create: if (can(tenantId, 'screens.manage') || can(tenantId, 'extensions.manage'))
          && (request.resource.data.get('editWindow', null) == null
              || can(tenantId, 'screens.edit-window') || can(tenantId, 'extensions.manage'))
          && (request.resource.data.get('portal', null) == null
              || can(tenantId, 'portal.manage') || can(tenantId, 'extensions.manage'))
          && (request.resource.data.get('memberVisibility', null) == null
              || can(tenantId, 'screens.member-visibility') || can(tenantId, 'extensions.manage'));
        // Numa tela que JÁ está no portal, a coleção, o pai e o título também decidem o que sai: trocar
        // o `dataCollection` projetaria outra coleção para os mesmos convidados, sem tocar no `portal`.
        // A janela de edição é a garantia de que um registro-prova não muda depois do prazo. Quem só
        // desenha telas não a abre: ela é de `screens.edit-window` (no Form Design) ou de quem instala
        // extensões. Compara-se o VALOR (ausente == null): o Form Design reenvia a tela inteira.
        // A visibilidade por registro (`memberVisibility`) segue o mesmo molde, com a permissão
        // `screens.member-visibility`: afrouxá-la entrega registros sigilosos a quem tem a coleção.
        // Na tela cujo portal oferece ações (`portal.actions`, por CHAVE), as ações do registro
        // (`viewActionIds`) decidem QUAL ação responde por cada chave — o que o convidado dispara.
        allow update: if (can(tenantId, 'screens.manage') || can(tenantId, 'extensions.manage'))
          && (request.resource.data.get('editWindow', null) == resource.data.get('editWindow', null)
              || can(tenantId, 'screens.edit-window') || can(tenantId, 'extensions.manage'))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['portal'])
              || can(tenantId, 'portal.manage') || can(tenantId, 'extensions.manage'))
          && (resource.data.get('portal', null) == null
              || !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['dataCollection', 'parentEntity', 'parentFieldKey', 'titleFieldKey'])
              || can(tenantId, 'portal.manage') || can(tenantId, 'extensions.manage'))
          && (resource.data.get('portal', null) == null
              || resource.data.portal.get('actions', null) == null
              || request.resource.data.get('viewActionIds', null) == resource.data.get('viewActionIds', null)
              || can(tenantId, 'portal.manage') || can(tenantId, 'extensions.manage'))
          && (request.resource.data.get('memberVisibility', null) == resource.data.get('memberVisibility', null)
              || can(tenantId, 'screens.member-visibility') || can(tenantId, 'extensions.manage'));
        // A visibilidade por registro mora NESTE documento: excluí-lo devolveria cada registro a todo
        // membro com a leitura da coleção. Quem só desenha telas não a retira por esse atalho.
        allow delete: if (can(tenantId, 'screens.manage') || can(tenantId, 'extensions.manage'))
          && (resource.data.get('memberVisibility', null) == null
              || can(tenantId, 'screens.member-visibility') || can(tenantId, 'extensions.manage'));
      }

      // ─── Registros de qualquer tela ─────────────────────────────────────────
      // Uma tela É uma coleção: `tenants/{tenantId}/medico/{id}`. O nome só existe em runtime
      // (o usuário cria a tela no Form Design), então não há como listá-lo aqui — daí o curinga.
      //
      // A lista de reservadas é OBRIGATÓRIA: o Firestore avalia todas as regras que casam e libera
      // se qualquer uma liberar. Sem ela, este bloco anularia as regras mais estritas acima
      // (workflow_executions com `write: if false`, members sem create/delete). É espelho de
      // RESERVED_COLLECTIONS em domain/schema/screenEntity.ts,
      // e o teste screenEntity.test.ts compara as duas pontas.
      //
      // A ESCRITA exige ainda que exista a tela declarada, para que nenhuma coleção inventada
      // receba dados. A LEITURA não exige: coleção sem tela está vazia. Ela lê o documento da tela por
      // outro motivo — a visibilidade por registro (`seesRecord`) mora nele, e é ele que diz se a
      // coleção restringe quem lê cada registro.
      function isReservedCollection(name) {
        return name in [
        'actions', 'agentGrants', 'aggregate_backfills', 'aiConnections',
        'documentTemplates', 'documentTypes', 'documents', 'downloads', 'extension_history', 'extension_migrations', 'extensions',
        'installed_extensions', 'lookupDefinitions', 'members', 'notes', 'notification_inbox', 'notification_dispatches', 'notification_contacts',
        'portalIdentityInvites', 'portalRecords', 'portalTexts', 'portalUsers', 'portal_reprojections', 'reports', 'roles',
        // `plugin_installations` não tem mais código que a leia — foi a instalação de antes de
        // `installed_extensions`. Continua RESERVADA porque os documentos de então continuam nos
        // escritórios, e liberar o nome deixaria uma tela nova nascer por cima deles.
        'tagDefinitions', 'plugin_installations',
        'recordKeys', 'record_key_adoptions', 'recordSequences', 'record_imports', 'record_search_jobs',
        'httpConnections', 'http_dispatches', 'screenDefinitions', 'scripts', 'secrets', 'settings', 'tags', 'tenant', 'workflow_clock',
        'workflow_definitions', 'workflow_events', 'workflow_executions', 'workflow_trigger_marks'
        ];
      }
      function isDeclaredScreen(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name));
      }
      // Uma lista de opções também é uma coleção que só existe em runtime, e cai neste mesmo
      // curinga — dois `match` com o mesmo padrão não são permitidos. Daí a segunda condição.
      function isDeclaredLookup(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/lookupDefinitions/$(name));
      }
      function isDeclaredTagList(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/tagDefinitions/$(name));
      }
      function isWritableScreen(name) {
        return !isReservedCollection(name)
          && (isDeclaredScreen(name) || isDeclaredLookup(name) || isDeclaredTagList(name));
      }
      // Quem grava numa coleção de tela é quem tem a PERMISSÃO dela — `medico.create`,
      // `medico.update`, `medico.delete`. O nome não está escrito em lugar nenhum: ele é montado a
      // partir da própria coleção, que é o que faz esta regra valer para uma tela criada no Form
      // Design cinco minutos atrás.
      //
      // Aqui morava `writeRoles`, a lista de papéis que a tela declarava. Ela resolvia o problema
      // certo — a tela decidindo quem grava nela — com o vocabulário errado: para alargar o acesso
      // de um mural era preciso nomear `user`, um papel que o produto impunha ao escritório. A
      // permissão derivada diz a mesma coisa sem nomear papel nenhum.
      function screenData(name) {
        return get(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name)).data;
      }
      function screenList(name, field) {
        return screenData(name).get(field, []) is list ? screenData(name).get(field, []) : [];
      }
      function canOnCollection(name, action) {
        return can(tenantId, name + '.' + action);
      }
      // Campos que QUALQUER membro grava, mesmo sem permissão de escrita na tela: o "por usuário" de
      // um mural — marcar como lida, curtir, guardar para depois. São gravações no documento que
      // OUTRA pessoa criou, e por isso o limite é a própria lista: a alteração é recusada se tocar
      // em qualquer campo fora dela. `updatedAt` entra porque o repositório sempre o carimba.
      function screenMemberWritableFields(name) {
        return screenList(name, 'memberWritableFields');
      }
      function touchesOnlyMemberWritableFields(name) {
        return isDeclaredScreen(name)
          && screenMemberWritableFields(name).size() > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(screenMemberWritableFields(name).concat(['updatedAt', 'updatedVia']));
      }
      // A tela que declara `authorCanDelete` deixa quem escreveu apagar o que escreveu, mesmo sem a
      // permissão de exclusão da coleção: ali a autoria É a posse — um comentário, um recado.
      function screenAuthorCanDelete(name) {
        return isDeclaredScreen(name)
          && get(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name))
               .data.get('authorCanDelete', false) == true;
      }
      function isRecordAuthor() {
        return resource.data.get('createdBy', '') == request.auth.uid;
      }
      // POR ONDE a gravação entrou (`createdVia`/`updatedVia`). O cliente só pode dizer `ui`: `agent` e
      // `automation` são escritos pelo Admin SDK, e é esta regra que impede uma tela — ou uma extensão
      // rodando nela — de fazer um registro digitado passar por gravado pela IA, ou o contrário.
      //
      // `portalVerified` — a identidade que o convidado provou ao gravar pelo portal — vai junto: só o
      // motor do servidor o escreve, e um cliente que o forjasse atribuiria a alguém de fora um ato que
      // ele não praticou.
      function declaresOnlyUiOnCreate() {
        return request.resource.data.get('createdVia', 'ui') == 'ui'
          && request.resource.data.get('updatedVia', 'ui') == 'ui'
          && !('portalVerified' in request.resource.data);
      }
      // A marca do RECÁLCULO de agregados (`updatedVia: 'aggregate-backfill'`) é o que faz uma
      // gravação passar sem evento `.saved` e sem auditoria. Ela fica no documento depois do
      // recálculo, e por isso não basta proibir o cliente de ESCREVÊ-LA: um update que não tocasse em
      // `updatedVia` a herdaria. O cliente só deixa um registro marcado assim no carimbo de exclusão
      // (`deletedBy*`), que é a única gravação dele que não carimba `updatedVia: 'ui'` — e que não
      // passaria pela marca, porque não mexe em campo derivado.
      function keepsWriteViaOnUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['createdVia', 'portalVerified'])
          && (!changed.hasAny(['updatedVia']) || request.resource.data.updatedVia == 'ui')
          && (request.resource.data.get('updatedVia', 'ui') != 'aggregate-backfill'
              || changed.hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL']));
      }

      // ─── Janela de edição (`editWindow`) ────────────────────────────────────
      //
      // O registro que vale como PROVA só muda até N minutos depois de criado. É AQUI que isso vale
      // como segurança: o formulário e a gravação do backend conferem a mesma conta
      // (`domain/schema/editWindow.ts`), mas só esta regra alcança quem grava direto no banco.
      //
      // Três travas, e nenhuma dispensável:
      // - na criação, `createdAt` é o relógio do SERVIDOR — sem isso, nascer com `createdAt` no ano
      //   3000 compraria uma janela eterna;
      // - na alteração, `createdAt` não muda — regravá-lo reabriria a janela;
      // - fora do prazo, só passa o que não é conteúdo: os campos de membro (marcar como lida) e, com a
      //   exclusão livre, o carimbo de quem exclui (`stampDeletionActor`, gravado logo antes).
      //
      // Declaração malformada e registro sem `createdAt` FECHAM: `minutes` que não é inteiro positivo
      // nega, e `is timestamp` falha no ausente. Ninguém passa por cima — nem o dono: o que muda a
      // janela é mudar a declaração, que exige `screens.edit-window` ou `extensions.manage` (ver
      // `screenDefinitions`).
      function editWindowOf(name) {
        return isDeclaredScreen(name) ? screenData(name).get('editWindow', null) : null;
      }
      function editWindowOpenSince(spec, createdAt) {
        return spec.get('minutes', null) is int
          && spec.minutes > 0
          && createdAt is timestamp
          && request.time < createdAt + duration.value(spec.minutes, 'm');
      }
      function insideEditWindow(spec) {
        return editWindowOpenSince(spec, resource.data.get('createdAt', null));
      }
      function editWindowExemptChange(name, spec) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(screenMemberWritableFields(name).concat(['updatedAt', 'updatedVia']))
          || (spec.get('delete', false) != true
              && changed.hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL']));
      }
      function respectsEditWindowOnCreate(name) {
        return editWindowOf(name) == null || request.resource.data.get('createdAt', null) == request.time;
      }
      function respectsEditWindowOnUpdate(name) {
        let spec = editWindowOf(name);
        return spec == null
          || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
              && (insideEditWindow(spec) || editWindowExemptChange(name, spec)));
      }
      function respectsEditWindowOnDelete(name) {
        let spec = editWindowOf(name);
        return spec == null || spec.get('delete', false) != true || insideEditWindow(spec);
      }
      // Os DOCUMENTOS do registro são parte da prova: fechada a janela do REGISTRO, nenhum sai — com ou
      // sem `delete: true`, porque tirar um anexo e pôr outro é trocar a prova sem que o registro mude
      // de data. Anexar continua livre. A única saída é a do próprio registro, quando a exclusão dele é
      // permitida: a cascata apaga o registro PRIMEIRO, e o documento de um registro que não existe
      // mais não é prova de nada.
      function recordDocumentsUnlocked(name, recordId) {
        let spec = editWindowOf(name);
        let record = /databases/$(database)/documents/tenants/$(tenantId)/$(name)/$(recordId);
        return spec == null
          || !exists(record)
          || editWindowOpenSince(spec, get(record).data.get('createdAt', null));
      }
      // ─── Visibilidade por registro (`memberVisibility`) ────────────────────
      //
      // A tela que a declara deixa cada membro ler só o registro que o NOMEIA num dos campos de
      // referência a membro — o uid gravado no campo simples, ou contido no `multi`. Quem tem a
      // permissão de supervisão lê todos: a declarada em `bypassPermission` ou, sem ela, a DERIVADA
      // `<coleção>.read-all`, que o catálogo oferece sozinho. O dono e o `SYSTEM` passam pelo `can()`.
      //
      // Os campos são lidos por POSIÇÃO, até quatro: a linguagem das regras não tem laço, e o teto é
      // o mesmo que o `check` do pacote e o Form Design cobram (`MEMBER_VISIBILITY_MAX_FIELDS`).
      // Declaração malformada fecha para quem não supervisiona: o que não é mapa, ou um `userFields`
      // que não é lista, não nomeia ninguém. `domain/schema/memberVisibility.ts` é o espelho.
      //
      // O `multi` é perguntado com `hasAny`, e não com `in`: sobre um MAPA, `in` pergunta pelas chaves,
      // e `{ <uid>: true }` gravado no campo passaria. `hasAny` só existe em lista. E os dois termos são
      // os que a consulta prova: a do cliente acrescenta o filtro sozinha (`memberVisibilityClauses`)
      // porque sem ele a consulta seria recusada INTEIRA — a regra não é filtro —, e cada disjunção do
      // `or()` dela casa com um destes termos.
      //
      // Custa a leitura de `screenDefinitions/<coleção>` em cada consulta e em cada documento lido — é o
      // documento que já respondia pela janela de edição e pelos campos de membro na gravação.
      function memberVisibilityOf(name) {
        return isDeclaredScreen(name) ? screenData(name).get('memberVisibility', null) : null;
      }
      function memberVisibilityFields(spec) {
        return spec is map && spec.get('userFields', []) is list ? spec.get('userFields', []) : [];
      }
      function memberVisibilityBypass(name, spec) {
        return spec is map && spec.get('bypassPermission', null) is string
          ? spec.get('bypassPermission', null)
          : name + '.read-all';
      }
      function namesMember(data, fields, index) {
        return fields.size() > index
          && fields[index] is string
          && (data.get(fields[index], null) == request.auth.uid
              || data.get(fields[index], []).hasAny([request.auth.uid]));
      }
      function seesRecord(name, data) {
        let spec = memberVisibilityOf(name);
        let fields = memberVisibilityFields(spec);
        return spec == null
          || namesMember(data, fields, 0)
          || namesMember(data, fields, 1)
          || namesMember(data, fields, 2)
          || namesMember(data, fields, 3)
          || can(tenantId, memberVisibilityBypass(name, spec));
      }
      // As anotações e os documentos são PARTE do registro: quem não o lê não lê, não acrescenta nem
      // apaga o que mora embaixo dele. A leitura do registro só acontece na tela que restringe.
      function seesParentRecord(name, recordId) {
        let record = /databases/$(database)/documents/tenants/$(tenantId)/$(name)/$(recordId);
        return memberVisibilityOf(name) == null
          || (exists(record) && seesRecord(name, get(record).data));
      }
      // A cascata apaga o registro ANTES dos filhos (ver "Janela de edição"). O filho de um registro que
      // não existe mais não é sigilo de ninguém, e precisa poder sair.
      function seesParentRecordOrGone(name, recordId) {
        let record = /databases/$(database)/documents/tenants/$(tenantId)/$(name)/$(recordId);
        return memberVisibilityOf(name) == null
          || !exists(record)
          || seesRecord(name, get(record).data);
      }

      // O hash do arquivo é calculado pelo servidor; o cliente nunca o escreve, nem ao criar.
      function omitsServerHash() {
        return !request.resource.data.keys().hasAny(['sha256']);
      }

      // Os termos de busca (`searchTerms`, `domain/schema/recordSearch.ts`) são do BACKEND: eles
      // carregam o título de registros de outras coleções, e só o gatilho que vê todas as gravações os
      // mantém coerentes. Um termo forjado pelo cliente faria um registro aparecer na busca por um nome
      // que ele não tem — e nenhuma tela mostraria de onde veio.
      function leavesSearchTermsToServerOnCreate() {
        return !('searchTerms' in request.resource.data);
      }
      function leavesSearchTermsToServerOnUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['searchTerms']);
      }

      // Uma LISTA DE OPÇÕES e um CONJUNTO DE ETIQUETAS são vocabulário, não dado: toda tela que os
      // referencia precisa deles para desenhar um `select` ou um chip, e exigir permissão de leitura
      // própria só produziria a tela meio carregada de quem tem acesso ao registro mas não à lista
      // que ele cita. GRAVAR neles continua exigindo a permissão da coleção, como em tudo o mais.
      function isDeclaredVocabulary(name) {
        return isDeclaredLookup(name) || isDeclaredTagList(name);
      }

      // ─── Reservas de chave (unicidade) ──────────────────────────────────────
      //
      // AQUI mora a garantia, e ela não é um "conferir antes de gravar".
      //
      // A gravação de um registro com chave é um LOTE: o documento mais uma reserva por chave, cujo
      // ID é derivado do valor. Este bloco libera `create` e não libera `update` — e `create`, no
      // Firestore, só dispara quando o documento NÃO existe. Escrever sobre uma reserva ocupada é um
      // `update` para a regra, é negado, e o lote inteiro falha atomicamente. Não há janela entre
      // conferir e gravar: duas gravações no mesmo instante não passam as duas.
      //
      // É a mesma forma de `/nicknames`, que já vivia neste arquivo para um caso só. E não pede
      // índice nenhum: a busca é por id de documento — a razão de preferir a reserva a consultar
      // antes de gravar, que além da corrida exigiria um índice por chave declarada.
      //
      // O que este arquivo NÃO consegue conferir: que o valor reservado é o valor gravado. A regra é
      // estática e as chaves são dado de runtime — um `match` genérico não computa um id derivado de
      // uma lista de campos que ele não conhece. Essa metade é cobrada nos dois pontos de gravação
      // (`recordRulesGate` no front, `runWorkflowUpsert` no backend), que é o mesmo patamar de
      // `required`, máscara e `rules.validate`. Ver "Chave primária e chave única" no ARCHITECTURE.md.
      match /recordKeys/{keyId} {
        // Ler a reserva é o que permite ao front dizer QUAL valor colidiu em vez de "acesso negado".
        allow read: if isMember(tenantId);
        allow create: if isWritableScreen(request.resource.data.get('collection', ''))
          && (canOnCollection(request.resource.data.collection, 'create')
              || canOnCollection(request.resource.data.collection, 'update'))
          && request.resource.data.keys().hasOnly(['collection', 'keyName', 'recordId', 'values', 'createdAt'])
          && request.resource.data.recordId is string
          && request.resource.data.keyName is string
          && request.resource.data.values is list;
        // Sem `update`, de propósito: é a ausência dele que faz o `create` ser a trava.
        allow delete: if canOnCollection(resource.data.get('collection', ''), 'update')
          || canOnCollection(resource.data.get('collection', ''), 'delete');
      }

      // ─── Contadores de sequência (`autoValue.sequence`) ─────────────────────
      //
      // O número que um registro recebe ao nascer vem de um contador, avançado na MESMA transação que
      // grava o registro. A transação é o que impede dois registros de lerem o mesmo valor; ESTE bloco
      // é o que impede qualquer cliente — inclusive um que não passe pelo repositório — de fazer o
      // contador repetir um número já dado:
      //
      // - nasce em 1, e só avança EXATAMENTE um por gravação. Não recua, não salta, não se apaga;
      // - o id é recomposto a partir do corpo (`coleção|campo|pai|período`), e por isso ninguém cria,
      //   sob o id do contador de uma coleção, um documento que diga ser de outra — onde a permissão
      //   conferida seria a da outra;
      // - o período, quando há, é o ano corrente com a folga de um fuso para cada lado.
      //
      // O que este arquivo NÃO consegue conferir é que o campo do registro carrega o valor do
      // contador: a regra é estática e o nome do campo é dado de runtime. Essa metade é dos dois pontos
      // de gravação — o mesmo patamar das reservas de chave logo acima.
      match /recordSequences/{sequenceId} {
        function wellFormedSequence(data) {
          return data.keys().hasOnly(['collection', 'field', 'parent', 'period', 'value', 'updatedAt'])
            && data.collection is string && data.collection.matches('[^|]+')
            && data.field is string && data.field.matches('[^|]+')
            && data.parent is string
            && data.period is string && data.period.matches('([0-9]{4})?')
            && data.value is int
            && sequenceId == data.collection + '|' + data.field + '|' + data.parent + '|' + data.period;
        }
        function currentPeriod(period) {
          return period == ''
            || period == string((request.time - duration.value(14, 'h')).year())
            || period == string((request.time + duration.value(14, 'h')).year());
        }
        // Ler o contador é o que a transação faz antes de avançá-lo. Ele diz quantos registros a
        // coleção já teve, e por isso só quem cria nela o lê. O inexistente é lido por qualquer membro:
        // é assim que a primeira gravação descobre que vai começar do 1.
        allow read: if isMember(tenantId)
          && (resource == null || canOnCollection(resource.data.get('collection', ''), 'create'));
        allow create: if wellFormedSequence(request.resource.data)
          && isWritableScreen(request.resource.data.collection)
          && canOnCollection(request.resource.data.collection, 'create')
          && currentPeriod(request.resource.data.period)
          && request.resource.data.value == 1;
        allow update: if wellFormedSequence(request.resource.data)
          && canOnCollection(resource.data.collection, 'create')
          && request.resource.data.collection == resource.data.collection
          && request.resource.data.field == resource.data.field
          && request.resource.data.parent == resource.data.parent
          && request.resource.data.period == resource.data.period
          && currentPeriod(request.resource.data.period)
          && request.resource.data.value == resource.data.value + 1;
        // Sem `delete`, de propósito: apagar o contador o faria recomeçar do 1.
      }

      match /{screenCollection}/{recordId} {
        allow read: if !isReservedCollection(screenCollection)
          && isMember(tenantId)
          && (canOnCollection(screenCollection, 'read') || isDeclaredVocabulary(screenCollection))
          && seesRecord(screenCollection, resource.data);
        allow create: if isWritableScreen(screenCollection)
          && canOnCollection(screenCollection, 'create')
          && declaresOnlyUiOnCreate()
          && leavesSearchTermsToServerOnCreate()
          && respectsEditWindowOnCreate(screenCollection);
        // Alterar e excluir pedem também VER o registro: quem não o lê não grava nele às cegas, e a
        // recusa não lhe conta que ele existe. Criar não pede — o registro pode nascer nomeando outra
        // pessoa, e é o encaminhamento que a restrição existe para permitir.
        allow update: if isWritableScreen(screenCollection)
          && keepsWriteViaOnUpdate()
          && leavesSearchTermsToServerOnUpdate()
          && respectsEditWindowOnUpdate(screenCollection)
          && (canOnCollection(screenCollection, 'update')
              || (isMember(tenantId) && touchesOnlyMemberWritableFields(screenCollection)))
          && seesRecord(screenCollection, resource.data);
        allow delete: if isWritableScreen(screenCollection)
          && respectsEditWindowOnDelete(screenCollection)
          && (canOnCollection(screenCollection, 'delete')
              || (canOnCollection(screenCollection, 'update')
                  && screenAuthorCanDelete(screenCollection)
                  && isRecordAuthor()))
          && seesRecord(screenCollection, resource.data);

        // Anotações do registro: seguem a permissão da COLEÇÃO DO PAI — a nota é parte do registro,
        // não uma entidade com acesso próprio. `update` só carimba a autoria de exclusão.
        match /notes/{noteId} {
          allow read: if !isReservedCollection(screenCollection)
            && isMember(tenantId)
            && canOnCollection(screenCollection, 'read')
            && seesParentRecord(screenCollection, recordId);
          allow create: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'update')
            && seesParentRecord(screenCollection, recordId);
          allow update: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL'])
            && request.resource.data.deletedBy == request.auth.uid
            && seesParentRecordOrGone(screenCollection, recordId);
          allow delete: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete')
            && seesParentRecordOrGone(screenCollection, recordId);
        }

        // Documentos do registro — mesmo modelo das anotações. Compartilhar no portal é EDITAR o
        // registro, e só mexe na marca: o arquivo, o nome e a autoria continuam de quem anexou — e por
        // isso passa depois da janela de edição, que só barra o carimbo de exclusão e a exclusão.
        // Nenhuma outra chave muda nunca: nome, tipo, arquivo e `sha256` são fixos desde o anexo.
        match /documents/{documentId} {
          allow read: if !isReservedCollection(screenCollection)
            && isMember(tenantId)
            && canOnCollection(screenCollection, 'read')
            && seesParentRecord(screenCollection, recordId);
          allow create: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'update')
            && request.resource.data.get('portalShared', false) == false
            && omitsServerHash()
            && seesParentRecord(screenCollection, recordId);
          allow update: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'update')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['portalShared', 'portalSharedBy', 'portalSharedAt'])
            && request.resource.data.portalShared is bool
            && request.resource.data.portalSharedBy == request.auth.uid
            && seesParentRecord(screenCollection, recordId);
          allow update: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL'])
            && request.resource.data.deletedBy == request.auth.uid
            && recordDocumentsUnlocked(screenCollection, recordId)
            && seesParentRecordOrGone(screenCollection, recordId);
          allow delete: if isWritableScreen(screenCollection) && canOnCollection(screenCollection, 'delete')
            && recordDocumentsUnlocked(screenCollection, recordId)
            && seesParentRecordOrGone(screenCollection, recordId);
        }
      }
    }

    // ─── Os portais de quem entra ─────────────────────────────────────────────
    // A consulta de GRUPO que descobre em quais escritórios a pessoa é convidada. Ela filtra por
    // `userId`, e é por ele que a regra decide — cada um acha só os próprios convites.
    match /{path=**}/portalUsers/{portalUserId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Filtros salvos ───────────────────────────────────────────────────────

    match /savedFilters/{filterId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ─── Logs de Auditoria ────────────────────────────────────────────────────
    // Coleção flat na raiz (não subcoleção de tenant). Escrita bloqueada para
    // todos os clientes — somente Cloud Functions (Admin SDK) criam documentos.

    match /auditLogs/{logId} {
      allow read: if request.auth != null && can(resource.data.tenantId, 'audit.read');
      allow write: if false;
    }

    // ─── Retenção da Auditoria e andamento do arquivo ─────────────────────────
    // Doc id = tenantId. A política (`retentionDays`, `archive`) e o estado da exportação (`state`).
    // Só o servidor grava: mudar a política passa pela callable `manageAuditArchive`, que cobra
    // `audit.manage`, valida a faixa e deixa a mudança na Auditoria — gravar direto pularia as três.
    // E o `state.headHash` é o que a verificação compara com o fim do arquivo: um cliente que o
    // reescrevesse esconderia o corte do fim.
    match /auditRetention/{tenantId} {
      allow read: if request.auth != null && can(tenantId, 'audit.read');
      allow write: if false;
    }

    // ─── Segundo fator (EV-07) ────────────────────────────────────────────────
    // A POLÍTICA do escritório muda só pela callable `manageMemberMfa` (`mfa.manage`), que valida, impede
    // quem grava de se trancar para fora, recompõe os membros e deixa a decisão na Auditoria — gravar
    // direto pularia as quatro. A leitura também passa por ela, e por isso aqui não se lê nada.
    match /memberMfaPolicies/{tenantId} {
      allow read, write: if false;
    }
    // O FATOR da pessoa: o segredo do aplicativo e o hash dos códigos de recuperação. Só o servidor o
    // lê — quem lesse o segredo geraria os códigos; quem o escrevesse escolheria o celular de outro.
    match /mfaFactors/{userId} {
      allow read, write: if false;
    }

    // ─── Cursor de leitura da Auditoria ───────────────────────────────────────
    // Doc id: `${userId}_${tenantId}`. Guarda só `lastReadAt` — usado para
    // calcular o badge de falhas CRITICAL não lidas (ver "Badge de falhas
    // críticas não lidas" no módulo de Auditoria). Mesmo padrão de savedFilters.

    match /auditLogReadCursors/{cursorId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ─── Catálogo de Steps do Workflow Engine ─────────────────────────────────
    // Coleção flat na raiz, global (não por tenant) — o catálogo de Steps disponíveis é o
    // mesmo para todos os escritórios. Espelho somente-leitura de StepDefinition (sem
    // `createExecutor`), escrito só pelo composition root em functions/ (Admin SDK).
    match /workflow_step_catalog/{stepDefinitionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // O que o provisionamento deixou para trás no projeto: Cloud Function e índice composto de
    // extensão que nenhum escritório instalou mais. Coleção flat na raiz porque a órfã é um fato do
    // PROJETO, não de um escritório — guardá-la por tenant seria a mesma resposta N vezes, com N
    // maneiras de divergir. Escrita SÓ pelo Microteia Console (credencial de administrador, que não
    // passa por estas regras); o cliente nunca escreve.
    //
    // Leitura para qualquer autenticado, como nas outras duas coleções globais. O documento é o
    // inventário de backend do projeto — nome de function e id de extensão —, e não carrega dado de
    // escritório nenhum. É ele que faz a tela de Extensões poder avisar quem não tem acesso ao projeto
    // Firebase de que há artefato a retirar, que é o único motivo de ele existir.
    match /backend_state/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Catálogo global de extensões publicadas pelos escritórios (modelo npm/VS Code). É a FRONTEIRA
    // de integridade da publicação — o app não usa Cloud Function aqui. É ESTE o catálogo da tela de
    // Extensões. Ver "Como uma extensão chega ao catálogo" no ARCHITECTURE.md.
    // - Qualquer autenticado lê.
    // - Publicar (create/update): o dono publica o que NÃO traz código, sempre 'approved'; com código,
    //   só SYSTEM. create só existe quando o doc não existe → domínio único global.
    // - Trocar de dono, aprovar e obsoletar: só SYSTEM.
    // - Apagar: só SYSTEM (o dono usa 'deprecated', não apaga do catálogo).
    match /public_extensions/{domain} {
      // `backendSource` conta como código, e é o mais pesado dos dois: a fonte de Cloud Function que
      // viaja no pacote roda no SERVIDOR de cada projeto que a aprovar. A aprovação por hash no Console
      // continua valendo na instalação; esta trava é a de quem PÕE no catálogo.
      function pkgHasCode() {
        return (('views' in request.resource.data.package)
            && request.resource.data.package.views.size() > 0)
          || ('backendSource' in request.resource.data.package);
      }
      // Extensão COM código roda no navegador de todo membro de todo escritório que a instalar: quem a
      // põe no catálogo é só a equipe global. Sem código o pacote é declaração, e quem administra o
      // escritório DONO publica direto — já aprovada, porque não há terceiro a quem consultar.
      function ownerPublishing() {
        return !pkgHasCode() && request.resource.data.status == 'approved';
      }
      allow read: if request.auth != null;
      allow create: if isSystemAdmin()
        || (can(request.resource.data.ownerTenantId, 'extensions.manage') && ownerPublishing());
      // Republicar = upsert: um identificador tem UM registro público, e o dono sobrescreve os
      // próprios dados. Trocar de dono, aprovar, obsoletar e publicar código são do SYSTEM.
      allow update: if isSystemAdmin()
        || (can(resource.data.ownerTenantId, 'extensions.manage')
            && request.resource.data.ownerTenantId == resource.data.ownerTenantId
            && ownerPublishing());
      allow delete: if isSystemAdmin();
    }

    // ─── Reputação de extensão — instalações e estrelas ────────────────────────
    // O agregado é escrito SÓ pelo Admin SDK (countExtensionInstalls, aggregateExtensionRatings). Ele
    // não mora em `public_extensions` porque o dono reescreve aquele documento a cada republicação, e
    // um número que o autor pode gravar não diz nada a quem lê.
    match /extension_stats/{pluginId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Um escritório que instalou: marcador da contagem. Nenhum cliente lê nem escreve — a lista
      // diria quais escritórios usam o quê.
      match /installs/{tenantId} {
        allow read, write: if false;
      }

      // Um voto por pessoa (id = uid), e só de quem é membro de um escritório que tem a extensão
      // instalada a partir do catálogo. A cópia privada não vota: o voto criaria o agregado com o
      // identificador de algo que nunca foi publicado.
      match /ratings/{userId} {
        function installedFromCatalog(tenantId, extensionId) {
          let installed = /databases/$(database)/documents/tenants/$(tenantId)/installed_extensions/$(extensionId);
          return exists(installed) && get(installed).data.get('source', 'public') != 'private';
        }
        function validVote(vote, extensionId) {
          return vote.keys().hasOnly(['stars', 'tenantId', 'updatedAt'])
            && vote.stars is int && vote.stars >= 1 && vote.stars <= 5
            && vote.tenantId is string
            && vote.updatedAt == request.time
            && isTenantMember(vote.tenantId)
            && installedFromCatalog(vote.tenantId, extensionId);
        }
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && validVote(request.resource.data, pluginId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Publicador verificado ─────────────────────────────────────────────────
    // Id = o escritório que publica. A verificação é do PUBLICADOR, e não da versão: republicar não a
    // apaga, e o dono não a concede a si mesmo — o nome que ele grava em `public_extensions` é livre,
    // e o selo existe justamente para não depender dele.
    match /extension_publishers/{tenantId} {
      allow read: if request.auth != null;
      allow create, update: if isSystemAdmin()
        && request.resource.data.keys().hasOnly(['verified', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.verified == true
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time;
      allow delete: if isSystemAdmin();
    }

    // ─── Pedidos de autorização de OAuth ───────────────────────────────────────
    // FECHADA para todo cliente, nas duas direções, e esta é a regra inteira.
    //
    // De raiz e não dentro de `tenants` porque, quando o documento nasce, ainda não há escritório:
    // quem chega é um navegador anônimo vindo do `/authorize`, e escolher o escritório é parte do
    // consentimento. Fechá-la não é excesso — o documento guarda o hash do código de autorização, e
    // quem lê o hash não tem o código, mas quem ESCREVE escolhe qual código vale. O navegador chega
    // ao que precisa por callable, filtrado, e nunca ao `codeHash`.
    match /agentAuthRequests/{requestId} {
      allow read, write: if false;
    }

    // O pedido de entrada no portal por um provedor de identidade: o verificador do PKCE, o `nonce` e
    // o escritório, entre a ida ao provedor e a volta. De RAIZ porque a volta traz só o `state`; FECHADA
    // porque quem lesse o verificador trocaria o código no lugar de quem entrou, e quem escrevesse
    // escolheria o `nonce` que o token tem de trazer. Só as callables `startPortalSignIn` e
    // `completePortalSignIn` o tocam.
    match /portalSignInRequests/{requestId} {
      allow read, write: if false;
    }

    // A marca da última abertura registrada de um convidado num registro de tela com
    // `portal.trackViews` — o freio de uma linha de Auditoria e um evento por janela. De RAIZ porque uma
    // gravação sob `tenants/{t}` acordaria os gatilhos de toda coleção; FECHADA porque quem a apagasse
    // registraria a mesma abertura quantas vezes quisesse, e quem a escrevesse silenciaria a próxima.
    // Só as callables `recordPortalView` e `getPortalDocumentUrl` a tocam.
    match /portalViewMarks/{markId} {
      allow read, write: if false;
    }

    // A prova da última entrada de cada conta aberta por um provedor do portal: provedor, `sub`,
    // nível e as claims de convite que ela satisfez. De RAIZ porque o uid já é do escritório e uma
    // gravação sob `tenants/{t}` acordaria os gatilhos de toda coleção; FECHADA porque quem a
    // escrevesse seria religado a qualquer convite refeito para a claim que escolhesse. Só a entrada
    // (`completePortalSignIn`) a grava, e só o convite por identidade a lê.
    match /portalIdentityProofs/{userId} {
      allow read, write: if false;
    }

  }
}
