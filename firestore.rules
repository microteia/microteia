rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────────────

    // Retorna os dados do usuário autenticado na coleção users
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário autenticado é administrador global do sistema
    function isSystemAdmin() {
      return request.auth != null && userData().role == 'SYSTEM';
    }

    // Verifica se o usuário autenticado é SYSTEM ou SUPPORT — ambos agem como
    // admin em QUALQUER tenant, mesmo sem um doc em members/{uid} daquele tenant
    // (usado pela equipe para prestar suporte a um escritório sem precisar de convite).
    function isSystemOrSupport() {
      return request.auth != null && userData().role in ['SYSTEM', 'SUPPORT'];
    }

    // Retorna os dados do membro do tenant
    function memberData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data;
    }

    // Verifica se o usuário é membro do tenant (ou SYSTEM/SUPPORT, que contam como membro de todos)
    function isMember(tenantId) {
      return request.auth != null &&
        (isSystemOrSupport() ||
         exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)));
    }

    // Verifica se o usuário tem role de admin no tenant (ou é SYSTEM/SUPPORT)
    function isTenantAdmin(tenantId) {
      return isSystemOrSupport() || (isMember(tenantId) && memberData(tenantId).role == 'admin');
    }

    // Verifica se o usuário pode escrever dados no tenant (admin, lawyer, secretary, ou SYSTEM/SUPPORT)
    function canWriteInTenant(tenantId) {
      return isSystemOrSupport() ||
        (isMember(tenantId) && memberData(tenantId).role in ['admin', 'lawyer', 'secretary']);
    }

    // ─── Usuários ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      // list: SYSTEM lista livremente (Gestão de Acessos, getUsers() sem limit()).
      // Qualquer outro autenticado só pode rodar consultas com limit() <= 1 — cobre a busca
      // exata por e-mail ao convidar membros (getUserByEmail usa limit(1)) sem permitir
      // dump da coleção inteira (emails/roles de todos os usuários) por um usuário comum.
      allow list: if isSystemAdmin()
        || (request.auth != null && request.query.limit <= 1);
      // O próprio documento é criado pela Cloud Function onUserCreated (Admin SDK,
      // trigger de Auth), nunca pelo client — por isso create é sempre negado aqui.
      allow create: if false;
      // Nenhum campo é editável pelo frontend fora da role, e só por SYSTEM. tenantIds e
      // qualquer outro campo são mantidos pelas Cloud Functions addTenantMember/removeTenantMember
      // (Admin SDK, ignoram estas regras) — o client não tem mais nenhum caminho de escrita
      // cross-user em users/{userId}.
      allow update: if isSystemAdmin();
    }

    // ─── Perfis de usuário ────────────────────────────────────────────────────
    
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow list: if isSystemAdmin()
        || (request.auth != null && request.query.limit <= 1);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Nicknames (unicidade) ────────────────────────────────────────────────

    match /nicknames/{nickname} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // `gmailConnections` (raiz) NÃO tem bloco aqui, e é de propósito: o Firestore nega o que nenhuma
    // regra libera, então `allow read, write: if false` não acrescentava nada — só dava a impressão de
    // que a proteção morava aqui. Quem escreve e lê essas conexões é a extensão de Pushes, pelo Admin
    // SDK, nas callables que ela declara em `manifest.backend`. Não há acesso pelo cliente.

    // ─── Tenants (escritórios) ────────────────────────────────────────────────  

    match /tenants/{tenantId} {
      // Qualquer membro pode ler o tenant
      allow get: if isMember(tenantId);
      // list: SYSTEM e SUPPORT listam a coleção inteira — usado tanto pela aba "Escritórios"
      // de Gestão de Acessos (SYSTEM) quanto pelo seletor de tenant no TopBar, que para esses
      // dois roles exibe todos os escritórios em vez de só os que o usuário é membro.
      // Sem esta regra, getDocs(collection('tenants')) é negado — "get" não cobre consultas de coleção.
      allow list: if isSystemOrSupport();
      // Admin do tenant atualiza os dados do escritório, mas nunca memberCount/memberLimit/ownerId/plan.
      // memberCount só é escrito pelas Cloud Functions addTenantMember/removeTenantMember (Admin SDK,
      // ignora estas regras); memberLimit e plan só por admin global (SYSTEM), na aba "Escritórios" de Gestão de Acessos.
      allow update: if isSystemAdmin()
        || (isTenantAdmin(tenantId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount', 'memberLimit', 'ownerId', 'plan']));
      // Tenant é criado pela Cloud Function onUserCreated (Admin SDK, trigger de Auth)
      // junto com o bootstrap do usuário — nunca pelo client.
      allow create: if false;
      allow delete: if false;

      // Conexões de IA do escritório — somente admin lê e escreve
      match /aiConnections/{connectionId} {
        allow read, write: if isTenantAdmin(tenantId);

        // Chave de API: admin pode ESCREVER (cadastro/troca), mas NUNCA LER.
        // Cloud Functions (Admin SDK) leem a chave, ignorando estas regras.
        match /secrets/{secretId} {
          allow read: if false;                  // Frontend NUNCA lê a chave
          allow write: if isTenantAdmin(tenantId);
        }
      }

      // Membros do tenant
      match /members/{memberId} {
        // Membros leem a lista de membros do próprio tenant
        allow read: if isMember(tenantId);
        // Criação e exclusão passam pelas Cloud Functions addTenantMember/removeTenantMember
        // (Admin SDK, ignoram estas regras) — garante que o limite de membros do tenant
        // (memberLimit/memberCount) nunca seja ultrapassado, mesmo por escritas diretas do client
        // ou por duas adições concorrentes (dois admins, dois computadores, ao mesmo tempo).
        allow create, delete: if false;
        // Alteração de role continua direta do client — não mexe no contador de membros.
        allow update: if isTenantAdmin(tenantId);
      }

      // Tipos de documento — compartilhado entre pessoas, processos e contratos
      match /documentTypes/{id} {
        allow read: if isMember(tenantId);
        allow create: if canWriteInTenant(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      // ─── Workflow Engine (Automações) ────────────────────────────────────────
      // Definições de automação — feature administrativa; só admin cria/edita/exclui.
      // `steps` fica embutido no próprio documento (ver "Workflow Engine" no corpo do doc).
      // Workflows públicos (isPublic === true) podem ser lidos por qualquer tenant autenticado
      // para permitir cópia (ver "Workflows Públicos" no corpo do doc).
      match /workflow_definitions/{workflowId} {
        allow read: if request.auth != null && 
        (isMember(tenantId) || resource.data.isPublic == true);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      // Scripts reutilizáveis executados pelo Step "Script" (sandbox QuickJS) — feature
      // administrativa; só admin cria/edita/exclui. Ver "Step Script" no corpo do doc.
      match /scripts/{scriptId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      // Ações customizadas exibidas nas telas de dados (botão -> workflow síncrono).
      // Todo membro lê (precisa montar os botões da tela); só admin configura.
      // Ver "Actions Customizadas" no corpo do doc.
      match /actions/{actionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      // Plugins instalados no escritório (Marketplace). Todo membro lê — o app precisa saber
      // quais extensões estão ativas para montar contribuições; só admin instala/atualiza/remove.
      match /plugin_installations/{pluginId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      // Extensões PRIVADAS do escritório (criadas na tela "Criar extensão"). Todo membro lê —
      // as ativas contribuem telas/menu no Kernel do tenant; só admin cria/edita/remove.
      match /extensions/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      // Extensões INSTALADAS (cópias fiéis da área pública ou de uma privada). Todo membro lê — as
      // ativas contribuem no Kernel; só admin instala/atualiza/desinstala. Independentes da fonte.
      match /installed_extensions/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      // Histórico de MIGRAÇÃO DE DADOS das extensões: o que cada uma já converteu neste escritório.
      // Todo membro lê — é o que mantém fora do boot a extensão com migração obrigatória em dívida, e
      // sem essa leitura cada navegador a carregaria sobre dado no formato antigo. Só admin grava, o
      // mesmo papel que instala e que a callable de execução exige. Sobrevive à desinstalação de
      // propósito: o dado migrado sobrevive, então reinstalar não pode reexecutar tudo de novo.
      match /extension_migrations/{extensionId} {
        allow read: if isMember(tenantId);
        allow create, update: if isTenantAdmin(tenantId);
        allow delete: if false;
      }

      // Configurações declaradas por plugins. Dois documentos, e o caminho decide quem grava:
      // `tenant` é o padrão do escritório (só admin) e `user_{uid}` é a preferência pessoal, que só
      // o dono escreve. Todo membro LÊ os dois — a resolução (usuário vence escritório) acontece no
      // cliente, e sem ler o padrão ninguém saberia o que herdar.
      match /settings/{settingsDocId} {
        allow read: if isMember(tenantId);
        allow create, update: if settingsDocId == 'tenant'
          ? isTenantAdmin(tenantId)
          : settingsDocId == 'user_' + request.auth.uid && isMember(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      // Event Bus do motor — qualquer membro com escrita pode publicar um evento;
      // coleção append-only, ninguém lê/edita/exclui pelo client (só a Cloud Function
      // onWorkflowEventCreated, via Admin SDK, que ignora estas regras).
      match /workflow_events/{eventId} {
        allow create: if canWriteInTenant(tenantId);
        allow read, update, delete: if false;
      }

      // Histórico de execução — só a Cloud Function grava (Admin SDK); membros só leem.
      match /workflow_executions/{executionId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // ─── Listas de opções declaradas pelo tenant ─────────────────────────────
      // O gêmeo, do lado do Firestore, do LOOKUP_REGISTRY de código. O id do documento É o nome da
      // coleção onde as opções ficam, e é este `exists()` que autoriza a escrita nela lá embaixo.
      match /lookupDefinitions/{lookupCollection} {
        allow read: if isMember(tenantId);
        allow create, update: if canWriteInTenant(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      // ─── Conjuntos de etiquetas declarados pelo tenant ───────────────────────
      // Mesmo papel de lookupDefinitions: o id do documento É o nome da coleção onde as etiquetas
      // ficam, e é este `exists()` que autoriza a escrita nela lá embaixo.
      match /tagDefinitions/{tagCollection} {
        allow read: if isMember(tenantId);
        allow create, update: if canWriteInTenant(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      // ─── Telas Dinâmicas (Personalização) ────────────────────────────────────
      // Definições de telas e campos customizados — membro lê; só admin configura
      match /screenDefinitions/{screenId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);

      }

      // ─── Registros de qualquer tela ─────────────────────────────────────────
      // Uma tela É uma coleção: `tenants/{tenantId}/medico/{id}`. O nome só existe em runtime
      // (o usuário cria a tela no Form Design), então não há como listá-lo aqui — daí o curinga.
      //
      // A lista de reservadas é OBRIGATÓRIA: o Firestore avalia todas as regras que casam e libera
      // se qualquer uma liberar. Sem ela, este bloco anularia as regras mais estritas acima
      // (workflow_executions com `write: if false`, members sem create/delete). É espelho de
      // RESERVED_COLLECTIONS em domain/schema/screenEntity.ts,
      // e o teste screenEntity.test.ts compara as duas pontas.
      //
      // A ESCRITA exige ainda que exista a tela declarada, para que nenhuma coleção inventada
      // receba dados. A LEITURA dispensa a checagem: coleção sem tela está vazia, e cobrar uma
      // leitura de documento por consulta não pagaria o que protege.
      function isReservedCollection(name) {
        return name in [
        'actions', 'aiConnections',
        'documentTypes', 'documents', 'extension_migrations', 'extensions',
        'installed_extensions', 'lookupDefinitions', 'members', 'notes',
        'tagDefinitions', 'plugin_installations',
        'screenDefinitions', 'scripts', 'secrets', 'settings', 'tags', 'tenant', 'workflow_definitions',
        'workflow_events', 'workflow_executions'
        ];
      }
      function isDeclaredScreen(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name));
      }
      // Uma lista de opções também é uma coleção que só existe em runtime, e cai neste mesmo
      // curinga — dois `match` com o mesmo padrão não são permitidos. Daí a segunda condição.
      function isDeclaredLookup(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/lookupDefinitions/$(name));
      }
      function isDeclaredTagList(name) {
        return exists(/databases/$(database)/documents/tenants/$(tenantId)/tagDefinitions/$(name));
      }
      function isWritableScreen(name) {
        return !isReservedCollection(name)
          && (isDeclaredScreen(name) || isDeclaredLookup(name) || isDeclaredTagList(name));
      }
      // A tela pode declarar QUEM grava nos seus registros (`writeRoles`). Declarada, a lista é a
      // AUTORIDADE — serve tanto para ESTREITAR ("só advogado ou admin mexe em processo") quanto
      // para ALARGAR ("no mural todo mundo comenta", incluindo o papel `user`, somente leitura no
      // resto do sistema). Ausente (o normal), vale a permissão padrão do escritório. É o que
      // permite uma entidade sair do kernel sem levar junto a regra nomeada que a protegia.
      // `.get(campo, padrão)` só devolve o padrão quando o campo está AUSENTE. Um campo gravado como
      // NULO passa por ele, e aí `.size()` estoura — e regra que estoura NEGA. É o que recusava toda
      // gravação nas coleções descritas por extensão que NÃO restringe papéis (`persons`, `deadlines`,
      // `news`: a instalação grava `writeRoles: null` para apagar um valor anterior), enquanto as que
      // restringem (`cases`, `financials`) gravavam normalmente. Toda lista de tela passa por aqui.
      function screenData(name) {
        return get(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name)).data;
      }
      function screenList(name, field) {
        return screenData(name).get(field, []) is list ? screenData(name).get(field, []) : [];
      }
      function screenWriteRoles(name) {
        return screenList(name, 'writeRoles');
      }
      function declaresWriteRoles(name) {
        return isDeclaredScreen(name) && screenWriteRoles(name).size() > 0;
      }
      // `isDeclaredScreen` primeiro: uma lista de opções ou um conjunto de etiquetas passa por este
      // mesmo curinga e NÃO tem documento de tela — o `get` acima falharia e negaria a escrita.
      function passesScreenWriteRoles(name) {
        return isSystemOrSupport()
          || (declaresWriteRoles(name)
                ? (isMember(tenantId) && memberData(tenantId).role in screenWriteRoles(name))
                : canWriteInTenant(tenantId));
      }
      // Campos que QUALQUER membro grava, mesmo sem permissão de escrita na tela: o "por usuário" de
      // um mural — marcar como lida, curtir, guardar para depois. São gravações no documento que
      // OUTRA pessoa criou, e por isso o limite é a própria lista: a alteração é recusada se tocar
      // em qualquer campo fora dela. `updatedAt` entra porque o repositório sempre o carimba.
      function screenMemberWritableFields(name) {
        return screenList(name, 'memberWritableFields');
      }
      function touchesOnlyMemberWritableFields(name) {
        return isDeclaredScreen(name)
          && screenMemberWritableFields(name).size() > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(screenMemberWritableFields(name).concat(['updatedAt']));
      }
      // Exclusão é ato de gestão, e por isso é de admin. A exceção é a tela que declara
      // `authorCanDelete`: ali a autoria É a posse — um comentário, um recado —, e quem escreveu
      // apaga o que escreveu. É a mesma frase que as regras nomeadas de `newsComments` diziam à mão,
      // agora lida da declaração da tela e válida para qualquer uma.
      function screenAuthorCanDelete(name) {
        return isDeclaredScreen(name)
          && get(/databases/$(database)/documents/tenants/$(tenantId)/screenDefinitions/$(name))
               .data.get('authorCanDelete', false) == true;
      }
      function isRecordAuthor() {
        return resource.data.get('createdBy', '') == request.auth.uid;
      }

      match /{screenCollection}/{recordId} {
        allow read: if !isReservedCollection(screenCollection) && isMember(tenantId);
        allow create: if isWritableScreen(screenCollection)
          && passesScreenWriteRoles(screenCollection);
        allow update: if isWritableScreen(screenCollection)
          && (passesScreenWriteRoles(screenCollection)
              || (isMember(tenantId) && touchesOnlyMemberWritableFields(screenCollection)));
        allow delete: if isWritableScreen(screenCollection)
          && (isTenantAdmin(tenantId)
              || (passesScreenWriteRoles(screenCollection)
                  && screenAuthorCanDelete(screenCollection)
                  && isRecordAuthor()));

        // Anotações do registro — mesmo modelo das entidades fixas: qualquer membro com escrita
        // cria; update só carimba a autoria de exclusão; exclusão só admin.
        match /notes/{noteId} {
          allow read: if !isReservedCollection(screenCollection) && isMember(tenantId);
          allow create: if isWritableScreen(screenCollection) && canWriteInTenant(tenantId);
          allow update: if isWritableScreen(screenCollection) && isTenantAdmin(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL'])
            && request.resource.data.deletedBy == request.auth.uid;
          allow delete: if isWritableScreen(screenCollection) && isTenantAdmin(tenantId);
        }

        // Documentos do registro — mesmo modelo das anotações
        match /documents/{documentId} {
          allow read: if !isReservedCollection(screenCollection) && isMember(tenantId);
          allow create: if isWritableScreen(screenCollection) && canWriteInTenant(tenantId);
          allow update: if isWritableScreen(screenCollection) && isTenantAdmin(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBy', 'deletedByName', 'deletedByPhotoURL'])
            && request.resource.data.deletedBy == request.auth.uid;
          allow delete: if isWritableScreen(screenCollection) && isTenantAdmin(tenantId);
        }
      }
    }

    // ─── Filtros salvos ───────────────────────────────────────────────────────

    match /savedFilters/{filterId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ─── Logs de Auditoria ────────────────────────────────────────────────────
    // Coleção flat na raiz (não subcoleção de tenant). Escrita bloqueada para
    // todos os clientes — somente Cloud Functions (Admin SDK) criam documentos.

    match /auditLogs/{logId} {
      allow read: if request.auth != null && isTenantAdmin(resource.data.tenantId);
      allow write: if false;
    }

    // ─── Cursor de leitura da Auditoria ───────────────────────────────────────
    // Doc id: `${userId}_${tenantId}`. Guarda só `lastReadAt` — usado para
    // calcular o badge de falhas CRITICAL não lidas (ver "Badge de falhas
    // críticas não lidas" no módulo de Auditoria). Mesmo padrão de savedFilters.

    match /auditLogReadCursors/{cursorId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ─── Catálogo de Steps do Workflow Engine ─────────────────────────────────
    // Coleção flat na raiz, global (não por tenant) — o catálogo de Steps disponíveis é o
    // mesmo para todos os escritórios. Espelho somente-leitura de StepDefinition (sem
    // `createExecutor`), escrito só pelo composition root em functions/ (Admin SDK).
    match /workflow_step_catalog/{stepDefinitionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Registro global de plugins do Marketplace. Qualquer autenticado lê (é o catálogo mostrado
    // na tela Extensões); só a equipe global (SYSTEM) publica/despublica — marketplace curado.
    // Ver "Registro global do Marketplace" no ARCHITECTURE.md.
    match /plugin_registry/{pluginId} {
      allow read: if request.auth != null;
      allow write: if isSystemAdmin();
    }

    // Catálogo global de extensões publicadas por usuários (modelo npm/VS Code). É a FRONTEIRA de
    // integridade da publicação/aprovação/imutabilidade — o app não usa Cloud Function aqui.
    // - Qualquer autenticado lê (é o catálogo "Públicas").
    // - Publicar (create): SYSTEM, ou admin do próprio escritório (ownerTenantId), e o status precisa
    //   bater com o código: extensão COM código entra 'pending' (aguarda aprovação do SYSTEM); SEM
    //   código entra 'approved'. create só existe quando o doc não existe → domínio único global.
    // - Atualizar (update): SYSTEM (aprovar/obsoletar/qualquer), ou o dono, mantendo o mesmo
    //   ownerTenantId. É UPSERT: um identificador tem UM registro público, então republicar
    //   sobrescreve os dados (qualquer versão) e o status volta a bater com o código (de código →
    //   'pending' de novo, re-aprovação).
    // - Apagar: só SYSTEM (usuário usa 'deprecated', não apaga do catálogo).
    match /public_extensions/{domain} {
      function pkgHasCode() {
        return ('views' in request.resource.data.package)
          && request.resource.data.package.views.size() > 0;
      }
      function statusMatchesCode() {
        return pkgHasCode()
          ? request.resource.data.status == 'pending'
          : request.resource.data.status == 'approved';
      }
      allow read: if request.auth != null;
      allow create: if isSystemAdmin()
        || (isTenantAdmin(request.resource.data.ownerTenantId) && statusMatchesCode());
      // Republicar = upsert: um identificador tem UM registro público. O dono sobrescreve seus
      // próprios dados (qualquer versão); o status volta a corresponder ao código (de código →
      // 'pending' de novo, re-aprovação). O SYSTEM aprova/obsoleta livremente.
      allow update: if isSystemAdmin()
        || (isTenantAdmin(resource.data.ownerTenantId)
            && request.resource.data.ownerTenantId == resource.data.ownerTenantId
            && statusMatchesCode());
      allow delete: if isSystemAdmin();
    }

  }
}
